---
import { VIDEO_LEYENDA } from '../data/videos';

// Detectar si el video está pendiente
const isPending = VIDEO_LEYENDA.youtubeId === 'PENDIENTE';
---

<section id="leyenda" class="relative py-28 md:py-40 overflow-hidden">

  <!-- Fondo negro puro para dramatismo -->
  <div class="absolute inset-0" style="background: #050805;" aria-hidden="true"></div>

  <!-- Gradiente de luz desde el centro -->
  <div
    class="absolute inset-0 opacity-40"
    style="background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(15,43,15,0.7) 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <!-- Número de sección -->
  <span class="section-number top-8 right-4 md:right-10" aria-hidden="true">04</span>

  <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-10 lg:px-16">

    <!-- Encabezado centrado -->
    <div class="text-center mb-16">
      <div class="flex items-center justify-center gap-4 mb-6" data-reveal>
        <div class="h-px w-12 bg-[#C41E3A]"></div>
        <span class="font-[family-name:var(--font-family-display)] text-xs tracking-[0.5em] uppercase text-[#C41E3A] font-600">
          La Historia
        </span>
        <div class="h-px w-12 bg-[#C41E3A]"></div>
      </div>

      <h2
        class="font-[family-name:var(--font-family-display)] font-800 text-[#F2EDE3] leading-none"
        style="font-size: clamp(2.8rem, 7vw, 6rem);"
        data-reveal
      >
        La Leyenda
      </h2>

      <p class="mt-4 text-[#6B7280] max-w-lg mx-auto text-sm leading-relaxed" data-reveal>
        El origen del colectivo, contado en imágenes.
      </p>
    </div>

    <!-- Contenedor del video -->
    <div class="max-w-4xl mx-auto" data-reveal-scale>
      {isPending ? (
        <!-- Placeholder — esperando URL del video final -->
        <div
          class="relative w-full rounded overflow-hidden flex items-center justify-center"
          style="aspect-ratio: 16/9; background: linear-gradient(135deg, #0A1A0A, #0D2B0D); border: 1px dashed rgba(196,30,58,0.4);"
        >
          <!-- Icono de play -->
          <div class="text-center">
            <div
              id="play-icon"
              class="w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4"
              style="background: rgba(196,30,58,0.15); border: 2px solid rgba(196,30,58,0.4);"
            >
              <svg width="28" height="28" viewBox="0 0 24 24" fill="#C41E3A" aria-hidden="true">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
            <p class="font-[family-name:var(--font-family-display)] text-[#C41E3A] text-sm tracking-[0.3em] uppercase font-600 mb-2">
              Video en producción
            </p>
            <p class="text-[#6B7280] text-xs tracking-wider">
              Editar <code class="text-[#9CA3AF]">src/data/videos.ts</code> → <code class="text-[#9CA3AF]">VIDEO_LEYENDA.youtubeId</code>
            </p>
          </div>

          <!-- Hojas decorativas dentro del placeholder -->
          <div class="absolute bottom-4 left-4 opacity-10" aria-hidden="true">
            <svg width="60" height="96" viewBox="0 0 80 130" fill="#2A6B2A">
              <path d="M40 125 C40 125 20 80 15 50 C10 20 30 2 40 2 C50 2 70 20 65 50 C60 80 40 125 40 125Z"/>
            </svg>
          </div>
          <div class="absolute top-4 right-4 opacity-10 rotate-180" aria-hidden="true">
            <svg width="50" height="80" viewBox="0 0 80 130" fill="#2A6B2A">
              <path d="M40 125 C40 125 20 80 15 50 C10 20 30 2 40 2 C50 2 70 20 65 50 C60 80 40 125 40 125Z"/>
            </svg>
          </div>
        </div>
      ) : (
        <!-- Embed de YouTube real -->
        <div class="relative w-full rounded overflow-hidden" style="aspect-ratio: 16/9;">
          <iframe
            class="absolute inset-0 w-full h-full"
            src={`https://www.youtube.com/embed/${VIDEO_LEYENDA.youtubeId}?rel=0&modestbranding=1&color=white`}
            title={VIDEO_LEYENDA.titulo}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      )}
    </div>

    <!-- Cita decorativa debajo del video -->
    <div class="text-center mt-12" data-reveal>
      <p
        class="font-[family-name:var(--font-family-display)] font-700 text-[#6B7280] text-lg tracking-widest uppercase"
        style="-webkit-text-stroke: 1px rgba(242,237,227,0.1);"
      >
        — Nasúa —
      </p>
    </div>
  </div>
</section>

<script>
  import { animate } from 'animejs';

  // Pulso en el ícono de play del placeholder
  const playIcon = document.getElementById('play-icon');
  if (playIcon) {
    animate(playIcon, {
      scale:    [1, 1.08],
      duration: 1800,
      loop:     true,
      alternate: true,
      ease:     'inOutSine',
    });
  }
</script>
