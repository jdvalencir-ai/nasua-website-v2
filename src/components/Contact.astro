---
import { CONTACTO, REDES } from '../data/config';
---

<section id="contacto" class="relative py-28 md:py-40 overflow-hidden">

  <!-- Fondo -->
  <div class="absolute inset-0" style="background: #050805;" aria-hidden="true"></div>
  <div
    class="absolute inset-0"
    style="background: radial-gradient(ellipse 50% 60% at 50% 100%, rgba(10,26,10,0.8) 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <!-- Número de sección -->
  <span class="section-number top-8 right-4 md:right-10" aria-hidden="true">08</span>

  <!-- Hojas decorativas -->
  <div class="absolute bottom-0 right-0 opacity-[0.06] rotate-[200deg] hidden lg:block" aria-hidden="true">
    <svg width="240" height="384" viewBox="0 0 80 130" fill="#1A4A1A">
      <path d="M40 125 C40 125 20 80 15 50 C10 20 30 2 40 2 C50 2 70 20 65 50 C60 80 40 125 40 125Z"/>
    </svg>
  </div>

  <!-- Divisor superior -->
  <div class="section-divider" aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-10 lg:px-16 pt-16">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">

      <!-- Columna izquierda: info de contacto -->
      <div>
        <div class="flex items-center gap-4 mb-6" data-reveal>
          <div class="h-px w-12 bg-[#C41E3A]"></div>
          <span class="font-[family-name:var(--font-family-display)] text-xs tracking-[0.5em] uppercase text-[#C41E3A] font-600">
            Contacto & Booking
          </span>
        </div>

        <h2
          class="font-[family-name:var(--font-family-display)] font-800 text-[#F2EDE3] leading-none mb-8"
          style="font-size: clamp(2.4rem, 5vw, 4rem);"
          data-reveal
        >
          Hablemos.
        </h2>

        <p class="text-[#9CA3AF] leading-relaxed text-lg mb-10" data-reveal>
          Para booking de shows, colaboraciones, medios de comunicación
          y prensa. Escríbenos y responderemos a la brevedad.
        </p>

        <!-- Email de contacto -->
        <div class="mb-8" data-reveal>
          <span class="block text-[10px] tracking-[0.4em] uppercase text-[#6B7280] font-[family-name:var(--font-family-display)] font-600 mb-2">
            Booking & Prensa
          </span>
          <a
            href={`mailto:${CONTACTO.email}?subject=${encodeURIComponent(CONTACTO.asunto)}`}
            class="font-[family-name:var(--font-family-display)] font-700 text-[#F2EDE3] text-xl hover:text-[#C41E3A] transition-colors duration-300 flex items-center gap-3 group"
          >
            {CONTACTO.email}
            <svg
              width="20" height="20" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2"
              class="opacity-0 group-hover:opacity-100 transition-all duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            >
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>

          <!-- Nota PENDIENTE -->
          <span class="mt-1 inline-flex items-center gap-1 text-[10px] text-[#C41E3A] opacity-60 font-mono">
            ✏️ PENDIENTE: confirmar email con el cliente
          </span>
        </div>

        <!-- Redes sociales -->
        <div data-reveal>
          <span class="block text-[10px] tracking-[0.4em] uppercase text-[#6B7280] font-[family-name:var(--font-family-display)] font-600 mb-4">
            Redes sociales
          </span>
          <div class="flex flex-wrap gap-4">

            <!-- Instagram -->
            {REDES.instagram && (
              <a
                href={REDES.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2.5 px-4 py-2.5 rounded transition-all duration-300 group/social"
                style="background: rgba(15,43,15,0.3); border: 1px solid rgba(42,107,42,0.2);"
                aria-label="Instagram de Nasúa Narica"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-[#9CA3AF] group-hover/social:text-[#F2EDE3] transition-colors" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
                <span class="text-xs font-[family-name:var(--font-family-display)] font-600 tracking-wider text-[#9CA3AF] group-hover/social:text-[#F2EDE3] transition-colors">
                  @nasuamusica
                </span>
              </a>
            )}

            <!-- YouTube -->
            {REDES.youtube && (
              <a
                href={REDES.youtube}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2.5 px-4 py-2.5 rounded transition-all duration-300 group/social"
                style="background: rgba(15,43,15,0.3); border: 1px solid rgba(42,107,42,0.2);"
                aria-label="YouTube de Nasúa Narica"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-[#9CA3AF] group-hover/social:text-[#F2EDE3] transition-colors" aria-hidden="true">
                  <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
                <span class="text-xs font-[family-name:var(--font-family-display)] font-600 tracking-wider text-[#9CA3AF] group-hover/social:text-[#F2EDE3] transition-colors">
                  YouTube
                </span>
              </a>
            )}

            <!-- Spotify (placeholder) -->
            {REDES.spotify && (
              <a
                href={REDES.spotify}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2.5 px-4 py-2.5 rounded transition-all duration-300 group/social"
                style="background: rgba(15,43,15,0.3); border: 1px solid rgba(42,107,42,0.2);"
                aria-label="Spotify de Nasúa Narica"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-[#9CA3AF] group-hover/social:text-[#F2EDE3] transition-colors" aria-hidden="true">
                  <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
                </svg>
                <span class="text-xs font-[family-name:var(--font-family-display)] font-600 tracking-wider text-[#9CA3AF] group-hover/social:text-[#F2EDE3] transition-colors">
                  Spotify
                </span>
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Columna derecha: logo grande + mensaje -->
      <div class="flex flex-col items-center lg:items-start justify-center" data-reveal-right>
        <div class="relative mb-8">
          <!-- Glow verde -->
          <div
            class="absolute inset-0 blur-3xl opacity-15"
            style="background: radial-gradient(circle, #2A6B2A 0%, transparent 70%); transform: scale(1.5);"
            aria-hidden="true"
          ></div>
          <img
            src="/logos/logo-full.png"
            alt="Nasúa Narica"
            class="logo-img relative z-10 w-40 md:w-52 h-auto"
            width="208"
            height="232"
            id="contact-logo"
          />
        </div>

        <blockquote
          class="font-[family-name:var(--font-family-display)] font-700 text-[#6B7280] text-base leading-relaxed tracking-wide italic mb-4 max-w-xs"
        >
          "La música no tiene fronteras.<br/>
          Nosotros tampoco."
        </blockquote>
        <cite class="text-[10px] tracking-[0.4em] uppercase text-[#6B7280] font-[family-name:var(--font-family-display)] font-600 not-italic">
          — Nasúa Narica, 2026
        </cite>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from 'animejs';

  const logo = document.getElementById('contact-logo');
  if (logo) {
    animate(logo, {
      scale:    [1, 1.03],
      duration: 4000,
      loop:     true,
      alternate: true,
      ease:     'inOutSine',
      delay:    500,
    });
  }
</script>
