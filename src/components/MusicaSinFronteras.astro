---
import { asset } from '../utils/asset';
// PENDIENTE: el cliente enviará el copy definitivo

const TITULO = 'Música Sin Fronteras';  // ← editar si cambia

// ─── PENDIENTE: Reemplazar con el copy final del cliente ───────────────────
const TEXTO_PRINCIPAL = `
  Nasúa es más que una banda: es un movimiento sonoro que cruza
  continentes, idiomas y géneros. "Música Sin Fronteras" es el manifiesto
  que define su sonido: pop tropical con influencias del afrobeat, el funk
  latinoamericano y la electrónica contemporánea.
`;

const TEXTO_SECUNDARIO = `
  Su música invita a moverse, a sentir y a conectar más allá de las
  diferencias. Cada producción es una exploración de texturas sonoras
  que mezclan lo orgánico con lo digital, lo ancestral con lo futuro.
`;
// ─── FIN PENDIENTE ──────────────────────────────────────────────────────────
---

<section
  id="musica"
  class="relative py-28 md:py-40 overflow-hidden"
>
  <!-- Fondo con textura selvática más intensa -->
  <div class="absolute inset-0" style="background: linear-gradient(135deg, #0A1A0A 0%, #070A07 40%, #0F2B0F 70%, #070A07 100%);" aria-hidden="true"></div>

  <!-- Patrón de líneas decorativas -->
  <div class="absolute inset-0 opacity-[0.03]" aria-hidden="true"
    style="background-image: repeating-linear-gradient(45deg, rgba(42,107,42,1) 0px, rgba(42,107,42,1) 1px, transparent 1px, transparent 40px);">
  </div>

  <!-- Número de sección -->
  <span class="section-number top-8 left-4 md:left-10" aria-hidden="true">03</span>

  <!-- Hojas decorativas -->
  <div class="absolute left-0 bottom-0 opacity-[0.08] -rotate-12 hidden lg:block" aria-hidden="true">
    <svg width="180" height="290" viewBox="0 0 80 130" fill="#1A4A1A">
      <path d="M40 125 C40 125 20 80 15 50 C10 20 30 2 40 2 C50 2 70 20 65 50 C60 80 40 125 40 125Z"/>
    </svg>
  </div>
  <div class="absolute right-8 top-20 opacity-[0.06] rotate-[160deg] hidden xl:block" aria-hidden="true">
    <svg width="120" height="195" viewBox="0 0 80 130" fill="#2A6B2A">
      <path d="M40 125 C40 125 20 80 15 50 C10 20 30 2 40 2 C50 2 70 20 65 50 C60 80 40 125 40 125Z"/>
    </svg>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-10 lg:px-16">

    <!-- Layout asimétrico tipo press kit -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

      <!-- Columna izquierda: wordmark grande -->
      <div class="lg:col-span-5 flex flex-col items-start" data-reveal-left>
        <div class="flex items-center gap-4 mb-8">
          <div class="h-px w-12 bg-[#E8681C]"></div>
          <span class="font-[family-name:var(--font-display)] text-xs tracking-[0.5em] uppercase text-[#E8681C] font-600">
            El concepto
          </span>
        </div>

        <!-- Logo horizontal como elemento visual -->
        <div class="relative">
          <img
            src={asset('/logos/logo-horizontal-dark.png')}
            alt="Nasúa"
            class="w-full max-w-sm h-auto mb-8"
            width="400"
            height="90"
          />
          <!-- Línea decorativa -->
          <div
            id="msf-line"
            class="h-px w-0"
            style="background: linear-gradient(90deg, #E8681C, #2A6B2A);"
            aria-hidden="true"
          ></div>
        </div>

        <!-- Stats musicales -->
        <div class="grid grid-cols-3 gap-6 mt-8 w-full">
          {[
            { num: '3+',   label: 'Años en escena'     },
            { num: '10+',  label: 'Releases'            },
            { num: '∞',    label: 'Sin fronteras'       },
          ].map(stat => (
            <div class="text-center md:text-left">
              <div class="font-[family-name:var(--font-display)] font-800 text-[#F2EDE3] text-3xl mb-1">
                {stat.num}
              </div>
              <div class="text-[10px] tracking-wider uppercase text-[#6B7280] font-[family-name:var(--font-display)] font-600">
                {stat.label}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Columna derecha: texto -->
      <div class="lg:col-span-7" data-reveal-right>
        <h2
          class="font-[family-name:var(--font-display)] font-800 text-[#F2EDE3] leading-tight mb-6"
          style="font-size: clamp(2rem, 4.5vw, 3.8rem);"
        >
          {TITULO}
        </h2>

        <!-- Copy editable en src/components/MusicaSinFronteras.astro → TEXTO_PRINCIPAL -->
        <p class="text-[#9CA3AF] text-lg leading-relaxed mb-5">
          {TEXTO_PRINCIPAL}
        </p>
        <p class="text-[#9CA3AF] leading-relaxed">
          {TEXTO_SECUNDARIO}
        </p>

        <!-- Géneros/tags de música -->
        <div class="flex flex-wrap gap-3 mt-8">
          {['Pop Tropical', 'Afrobeat', 'Funk Latino', 'Electrónica', 'Global Bass'].map((g, i) => (
            <span
              class="genre-tag font-[family-name:var(--font-display)] text-[11px] tracking-wider uppercase font-700 px-4 py-2 opacity-0"
              style={`background: rgba(42,107,42,0.12); border: 1px solid rgba(42,107,42,0.25); color: #6B7280; transition-delay: ${i * 60}ms;`}
            >
              {g}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from 'animejs';

  // Animar línea decorativa al entrar la sección
  const line = document.getElementById('msf-line');
  if (line) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animate(line, { width: ['0px', '100%'], duration: 800, ease: 'outExpo' });
          obs.disconnect();
        }
      });
    }, { threshold: 0.3 });
    obs.observe(line);
  }

  // Tags con stagger
  const tags = document.querySelectorAll('.genre-tag');
  const tagObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        animate(tags, {
          opacity:    [0, 1],
          translateY: [10, 0],
          delay:      (el, i) => i * 60,
          duration:   400,
          ease:       'outQuart',
        });
        tagObs.disconnect();
      }
    });
  }, { threshold: 0.3 });
  if (tags[0]) tagObs.observe(tags[0]);
</script>
