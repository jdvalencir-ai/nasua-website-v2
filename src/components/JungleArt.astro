  <use href="#banana" transform="translate(1290,720) rotate(-20) scale(2.0)" fill="url(#g-mid)"/>

  <!-- ════ TUCÁN (arriba-izq, sobre liana) ════ -->
  <g transform="translate(322,200) scale(1.7)">
    <path d="M-28,12 L-50,30 C-54,34 -48,40 -43,36 L-20,22 Z" fill="#161616"/>
    <ellipse cx="0" cy="6" rx="29" ry="25" fill="#1A1A1A"/>
    <path d="M-7,-12 C-21,-6 -23,18 -9,27 C3,23 4,-7 -7,-12 Z" fill="#F2C53D"/>
    <path d="M-9,24 C-3,29 7,27 10,20 C3,25 -4,26 -9,24 Z" fill="#E8681C"/>
    <circle cx="13" cy="-17" r="19" fill="#1A1A1A"/>
    <circle cx="21" cy="-21" r="8"   fill="#2E7E96"/>
    <circle cx="22" cy="-21" r="5"   fill="#EDE8E0"/>
    <circle cx="23" cy="-21" r="2.6" fill="#0A0A0A"/>
    <path d="M29,-26 C62,-31 82,-20 84,-7 C82,3 58,3 33,-5 C27,-12 25,-22 29,-26 Z" fill="url(#g-beak)"/>
    <path d="M30,-25 C50,-27 70,-24 82,-11" stroke="#B83A0A" stroke-width="1.4" fill="none" opacity="0.5"/>
    <path d="M-6,29 L-6,39 M-6,39 L-12,45 M-6,39 L0,45" stroke="#E8681C" stroke-width="2.4" stroke-linecap="round" fill="none"/>
    <path d="M9,29 L9,39 M9,39 L3,45 M9,39 L15,45"      stroke="#E8681C" stroke-width="2.4" stroke-linecap="round" fill="none"/>
  </g>

  <!-- ════ COATÍ (protagonista, der, mira al centro) ════ -->
  <g transform="translate(1196,652) scale(-1.62,1.62)">
    <ellipse cx="6" cy="46" rx="60" ry="12" fill="#000" fill-opacity="0.25"/>
    <path d="M-44,-4 C-78,-24 -88,-82 -64,-124 C-50,-150 -20,-154 -12,-130"
          fill="none" stroke="#3A2614" stroke-width="22" stroke-linecap="round"/>
    <path d="M-44,-4 C-78,-24 -88,-82 -64,-124 C-50,-150 -20,-154 -12,-130"
          fill="none" stroke="#7A5028" stroke-width="22" stroke-linecap="round" stroke-dasharray="4 22"/>
    <circle cx="-13" cy="-131" r="11" fill="#241608"/>
    <ellipse cx="-28" cy="6" rx="40" ry="36" fill="#34220F"/>
    <ellipse cx="12" cy="2" rx="48" ry="32" fill="#4A3018"/>
    <path d="M-22,-24 C0,-34 32,-33 54,-20" stroke="#7A5028" stroke-width="3.5" fill="none" opacity="0.45" stroke-linecap="round"/>
    <ellipse cx="2" cy="24" rx="46" ry="13" fill="#2A1A0C" opacity="0.55"/>
    <path d="M34,24 L31,58 C31,64 45,64 45,58 L47,26 Z" fill="#241608"/>
    <path d="M6,28 L3,60 C3,66 16,66 16,60 L18,28 Z"     fill="#2E1D0E"/>
    <ellipse cx="-30" cy="42" rx="17" ry="10" fill="#241608"/>
    <path d="M44,-8 C54,-26 62,-38 74,-44 L72,2 C60,6 50,4 44,-8 Z" fill="#4A3018"/>
    <circle cx="74" cy="-44" r="17" fill="#4A3018"/>
    <path d="M66,-58 C63,-70 76,-72 82,-62 C79,-56 72,-56 66,-58 Z" fill="#2E1D0E"/>
    <path d="M86,-48 C112,-54 140,-58 158,-56 C163,-55 163,-49 158,-48 C140,-46 116,-42 92,-38 C84,-42 82,-46 86,-48 Z" fill="#6E4A28"/>
    <path d="M96,-50 C120,-54 144,-57 158,-55 C150,-58 120,-57 96,-50 Z" fill="#8A6238" opacity="0.7"/>
    <ellipse cx="159" cy="-52" rx="7" ry="6" fill="#160C04"/>
    <path d="M92,-37 C112,-40 134,-44 154,-48" stroke="#241608" stroke-width="2" fill="none" opacity="0.4" stroke-linecap="round"/>
    <path d="M64,-48 C72,-52 82,-50 88,-45" stroke="#B89060" stroke-width="3.5" fill="none" opacity="0.55" stroke-linecap="round"/>
    <circle cx="72" cy="-46" r="4.4" fill="#140A03"/>
    <circle cx="73.6" cy="-47.6" r="1.5" fill="#EDE8E0" fill-opacity="0.8"/>
  </g>

  <!-- Mata frente al coatí -->
  <use href="#fern" transform="translate(1196,710) rotate(8) scale(2.0)" fill="#1A5E2A"/>
  <use href="#mon"  transform="translate(1132,726) rotate(-12) scale(1.8)" fill="url(#g-front)"/>
  <use href="#lf"   transform="translate(1248,716) rotate(22) scale(1.7)" fill="#46B857"/>

  <!-- ════ BANDA INFERIOR — clusters variados (no fila uniforme) ════ -->
