---
// Ilustración flat / paper-cut de la selva — nivel diseñador
// Técnica clave: cada hoja tiene LUZ (highlight) + SOMBRA + nervaduras,
// variedad real de plantas, gradientes ricos y flores heliconia.
// Protagonista: el coatí (nombre de la banda).
---

<svg
  class="jungle-art absolute inset-0 w-full h-full pointer-events-none"
  viewBox="0 0 1440 900"
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
>
  <defs>
    <!-- ── Gradientes de masa (multi-stop = volumen) ── -->
    <linearGradient id="g-back" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#13491F"/><stop offset="0.6" stop-color="#0A2812"/><stop offset="1" stop-color="#061A0B"/>
    </linearGradient>
    <linearGradient id="g-mid" x1="0.1" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2E9440"/><stop offset="0.55" stop-color="#1A5E2A"/><stop offset="1" stop-color="#103A1B"/>
    </linearGradient>
    <linearGradient id="g-front" x1="0.1" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#52C063"/><stop offset="0.5" stop-color="#34A046"/><stop offset="1" stop-color="#1E6B2E"/>
    </linearGradient>
    <linearGradient id="g-lime" x1="0.1" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9CE866"/><stop offset="0.55" stop-color="#6FCB4B"/><stop offset="1" stop-color="#3FA84E"/>
    </linearGradient>
    <linearGradient id="g-teal" x1="0.1" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3FB58A"/><stop offset="0.5" stop-color="#1E7A52"/><stop offset="1" stop-color="#0E4A30"/>
    </linearGradient>
    <linearGradient id="g-yellow" x1="0.1" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#C2E84E"/><stop offset="0.55" stop-color="#86C23A"/><stop offset="1" stop-color="#4F8A2A"/>
    </linearGradient>
    <linearGradient id="g-heli" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F7A24A"/><stop offset="0.5" stop-color="#E8681C"/><stop offset="1" stop-color="#B83A0A"/>
    </linearGradient>
    <linearGradient id="g-beak" x1="0" y1="0" x2="1" y2="0.3">
      <stop offset="0" stop-color="#F7A24A"/><stop offset="0.55" stop-color="#E8681C"/><stop offset="1" stop-color="#B83A0A"/>
    </linearGradient>
    <radialGradient id="g-sun" cx="0.5" cy="0.4" r="0.6">
      <stop offset="0" stop-color="#F2C53D" stop-opacity="0.14"/><stop offset="1" stop-color="#F2C53D" stop-opacity="0"/>
    </radialGradient>

    <!-- ── Paths base (sin fill: heredan el color del <use>) ── -->
    <path id="p-leaf"   d="M0,-32 C13,-24 14,16 0,32 C-14,16 -13,-24 0,-32 Z"/>
    <path id="p-banana" d="M0,-72 C21,-58 25,40 9,69 C4,73 -4,73 -9,69 C-25,40 -21,-58 0,-72 Z"/>
    <path id="p-mon"
      d="M0,-58 C12,-56 16,-50 18,-44 C26,-47 31,-44 33,-37 C35,-27 26,-25 20,-25
         C31,-19 39,-8 39,5 C39,17 31,23 22,29 C14,41 6,50 0,55
         C-6,50 -14,41 -22,29 C-31,23 -39,17 -39,5 C-39,-8 -31,-19 -20,-25
         C-26,-25 -35,-27 -33,-37 C-31,-44 -26,-47 -18,-44 C-16,-50 -12,-56 0,-58 Z"/>

    <!-- ── Símbolos con luz + sombra + nervadura ── -->
    <g id="lf">
      <use href="#p-leaf"/>
      <use href="#p-leaf" transform="translate(-2,-3) scale(0.78)" fill="#fff" fill-opacity="0.14"/>
      <use href="#p-leaf" transform="translate(3,5)  scale(0.8)"  fill="#000" fill-opacity="0.12"/>
      <path d="M0,-27 L0,27" stroke="#06140A" stroke-opacity="0.4" stroke-width="1.5" fill="none"/>
    </g>

    <g id="banana">
      <use href="#p-banana"/>
      <use href="#p-banana" transform="translate(-3,-4) scale(0.82)" fill="#fff" fill-opacity="0.13"/>
      <use href="#p-banana" transform="translate(4,6)  scale(0.84)"  fill="#000" fill-opacity="0.13"/>
      <path d="M0,-66 L0,64" stroke="#06140A" stroke-opacity="0.4" stroke-width="2" fill="none"/>
      <!-- nervaduras laterales -->
      <g stroke="#06140A" stroke-opacity="0.25" stroke-width="1.2" fill="none">
        <path d="M0,-40 C8,-42 13,-40 17,-34"/><path d="M0,-40 C-8,-42 -13,-40 -17,-34"/>
        <path d="M0,-14 C9,-16 15,-13 19,-6"/>  <path d="M0,-14 C-9,-16 -15,-13 -19,-6"/>
        <path d="M0,12 C9,10 15,13 18,20"/>     <path d="M0,12 C-9,10 -15,13 -18,20"/>
        <path d="M0,36 C8,34 13,37 15,44"/>     <path d="M0,36 C-8,34 -13,37 -15,44"/>
      </g>
    </g>

    <g id="mon">
      <use href="#p-mon"/>
      <use href="#p-mon" transform="translate(-3,-4) scale(0.8)" fill="#fff" fill-opacity="0.12"/>
      <use href="#p-mon" transform="translate(4,6)  scale(0.82)" fill="#000" fill-opacity="0.12"/>
      <!-- fenestraciones (huecos) -->
      <ellipse cx="-15" cy="-4" rx="5" ry="11" fill="#000" fill-opacity="0.32" transform="rotate(-16 -15 -4)"/>
      <ellipse cx="15"  cy="-4" rx="5" ry="11" fill="#000" fill-opacity="0.32" transform="rotate(16 15 -4)"/>
      <ellipse cx="-10" cy="24" rx="4" ry="8"  fill="#000" fill-opacity="0.28"/>
      <ellipse cx="10"  cy="24" rx="4" ry="8"  fill="#000" fill-opacity="0.28"/>
      <path d="M0,-54 L0,52" stroke="#06140A" stroke-opacity="0.38" stroke-width="2" fill="none"/>
      <g stroke="#06140A" stroke-opacity="0.22" stroke-width="1.1" fill="none">
        <path d="M0,-30 L24,-34"/><path d="M0,-30 L-24,-34"/>
        <path d="M0,2 L34,2"/>    <path d="M0,2 L-34,2"/>
        <path d="M0,30 L20,40"/>  <path d="M0,30 L-20,40"/>
      </g>
    </g>

    <!-- Palma abanico (blades con luz propia) -->
    <g id="fan">
      <use href="#lf" transform="translate(0,-34) scale(1.0,1.55)"/>
      <use href="#lf" transform="rotate(-26) translate(0,-32) scale(0.92,1.35)"/>
      <use href="#lf" transform="rotate(26)  translate(0,-32) scale(0.92,1.35)"/>
      <use href="#lf" transform="rotate(-50) translate(0,-28) scale(0.82,1.15)"/>
      <use href="#lf" transform="rotate(50)  translate(0,-28) scale(0.82,1.15)"/>
      <use href="#lf" transform="rotate(-72) translate(0,-22) scale(0.72,0.95)"/>
      <use href="#lf" transform="rotate(72)  translate(0,-22) scale(0.72,0.95)"/>
    </g>

    <!-- Helecho (frond plumoso) -->
    <g id="fern">
      <path d="M0,46 C-2,12 -2,-22 0,-52" stroke="#000" stroke-opacity="0.18" stroke-width="2" fill="none"/>
      <g>
        <ellipse cx="-10" cy="34" rx="11" ry="3.6" transform="rotate(26 -10 34)"/><ellipse cx="10" cy="34" rx="11" ry="3.6" transform="rotate(-26 10 34)"/>
        <ellipse cx="-10" cy="18" rx="12" ry="3.6" transform="rotate(26 -10 18)"/><ellipse cx="10" cy="18" rx="12" ry="3.6" transform="rotate(-26 10 18)"/>
        <ellipse cx="-9"  cy="2"  rx="11" ry="3.4" transform="rotate(26 -9 2)"/>  <ellipse cx="9"  cy="2"  rx="11" ry="3.4" transform="rotate(-26 9 2)"/>
        <ellipse cx="-8"  cy="-14" rx="9" ry="3.2" transform="rotate(26 -8 -14)"/><ellipse cx="8"  cy="-14" rx="9" ry="3.2" transform="rotate(-26 8 -14)"/>
        <ellipse cx="-6"  cy="-30" rx="7" ry="2.8" transform="rotate(26 -6 -30)"/><ellipse cx="6"  cy="-30" rx="7" ry="2.8" transform="rotate(-26 6 -30)"/>
        <ellipse cx="-4"  cy="-44" rx="5" ry="2.4" transform="rotate(26 -4 -44)"/><ellipse cx="4"  cy="-44" rx="5" ry="2.4" transform="rotate(-26 4 -44)"/>
      </g>
      <!-- highlight de un lado -->
      <g fill="#fff" fill-opacity="0.12">
        <ellipse cx="10" cy="34" rx="6" ry="1.8" transform="rotate(-26 10 34)"/>
        <ellipse cx="10" cy="18" rx="6" ry="1.8" transform="rotate(-26 10 18)"/>
        <ellipse cx="9"  cy="2"  rx="6" ry="1.8" transform="rotate(-26 9 2)"/>
      </g>
    </g>

    <!-- Junco / pasto alto -->
    <g id="reed">
      <use href="#p-leaf" transform="scale(0.34,3.0)"/>
      <use href="#p-leaf" transform="translate(0,6) scale(0.26,2.4)" fill="#fff" fill-opacity="0.12"/>
    </g>

    <!-- Heliconia (pinza de langosta) — acento tropical de marca -->
    <g id="heli">
      <path d="M0,52 L0,-42" stroke="#1E6B2E" stroke-width="4.5" fill="none" stroke-linecap="round"/>
      <g stroke="#7A2A06" stroke-opacity="0.35" stroke-width="0.8">
        <path d="M0,40 C18,38 27,30 25,21 C14,23 4,30 0,40 Z" fill="url(#g-heli)"/>
        <path d="M0,23 C-18,21 -27,13 -25,4 C-14,6 -4,13 0,23 Z" fill="url(#g-heli)"/>
        <path d="M0,6 C16,4 24,-4 22,-12 C12,-10 3,-4 0,6 Z" fill="url(#g-heli)"/>
        <path d="M0,-11 C-15,-13 -23,-21 -21,-29 C-11,-27 -3,-21 0,-11 Z" fill="url(#g-heli)"/>
        <path d="M0,-26 C13,-28 20,-35 18,-42 C9,-40 2,-34 0,-26 Z" fill="url(#g-heli)"/>
      </g>
      <g fill="#FFD27A" fill-opacity="0.5">
        <ellipse cx="20" cy="32" rx="3" ry="2"/><ellipse cx="-20" cy="15" rx="3" ry="2"/><ellipse cx="18" cy="-2" rx="2.6" ry="1.8"/>
      </g>
    </g>

    <!-- Sprig decorativo -->
    <g id="sprig">
      <path d="M0,0 C6,-14 10,-28 12,-44" stroke="#2E9440" stroke-width="2.5" fill="none" stroke-linecap="round"/>
      <use href="#lf" transform="translate(6,-16) rotate(45) scale(0.42)"   fill="#2E9440"/>
      <use href="#lf" transform="translate(2,-10) rotate(-50) scale(0.38)"  fill="#46B857"/>
      <use href="#lf" transform="translate(10,-30) rotate(40) scale(0.36)"  fill="#46B857"/>
      <use href="#lf" transform="translate(12,-44) rotate(8)  scale(0.34)"  fill="#6FCB4B"/>
    </g>
  </defs>

  <!-- ════ FONDO: dosel lejano ════ -->
  <ellipse cx="180"  cy="-50"  rx="380" ry="210" fill="url(#g-back)"/>
  <ellipse cx="720"  cy="-90"  rx="470" ry="220" fill="#061A0B"/>
  <ellipse cx="1260" cy="-50"  rx="400" ry="210" fill="url(#g-back)"/>
  <ellipse cx="980"  cy="-110" rx="300" ry="170" fill="#04140A"/>
  <ellipse cx="420"  cy="-100" rx="260" ry="150" fill="#04140A"/>

  <!-- Resplandor cálido -->
  <ellipse cx="720" cy="40" rx="600" ry="360" fill="url(#g-sun)"/>

  <!-- Rayos de luz -->
  <polygon points="430,-40 520,-40 360,560 290,560" fill="#F2C53D" opacity="0.04"/>
  <polygon points="760,-40 820,-40 700,520 650,520" fill="#F2C53D" opacity="0.033"/>
  <polygon points="980,-40 1030,-40 920,500 875,500" fill="#F2C53D" opacity="0.03"/>

  <!-- ════ LIANAS ════ -->
  <path d="M300,-20 C290,120 312,260 300,400" stroke="#0E3A1B" stroke-width="4" fill="none" opacity="0.8"/>
  <path d="M340,-20 C352,110 330,240 344,360" stroke="#0E3A1B" stroke-width="3" fill="none" opacity="0.7"/>
  <path d="M1120,-20 C1132,130 1108,270 1124,410" stroke="#0E3A1B" stroke-width="4" fill="none" opacity="0.8"/>
  <path d="M1170,-20 C1158,120 1182,250 1166,380" stroke="#0E3A1B" stroke-width="3" fill="none" opacity="0.6"/>
  <use href="#lf" transform="translate(300,180) rotate(40) scale(0.55)"  fill="#13491F"/>
  <use href="#lf" transform="translate(344,260) rotate(-44) scale(0.5)"  fill="#13491F"/>
  <use href="#lf" transform="translate(1124,210) rotate(-40) scale(0.55)" fill="#13491F"/>

  <!-- ════ PARED IZQUIERDA (capas con profundidad) ════ -->
  <use href="#fan"    transform="translate(40,560)  rotate(-24) scale(2.7)" fill="#0E3A1B"/>
  <use href="#mon"    transform="translate(120,640) rotate(-12) scale(2.7)" fill="url(#g-back)"/>
  <use href="#fan"    transform="translate(60,700)  rotate(-34) scale(2.4)" fill="#103A1B"/>
  <use href="#mon"    transform="translate(195,705) rotate(14)  scale(2.1)" fill="#13491F"/>
  <use href="#fern"   transform="translate(95,690)  rotate(-14) scale(2.3)" fill="#1A5E2A"/>
  <use href="#banana" transform="translate(150,720) rotate(20)  scale(2.0)" fill="url(#g-mid)"/>

  <!-- ════ PARED DERECHA ════ -->
  <use href="#fan"    transform="translate(1400,560) rotate(24)  scale(2.7)" fill="#0E3A1B"/>
  <use href="#mon"    transform="translate(1320,640) rotate(12)  scale(2.7)" fill="url(#g-back)"/>
