  <use href="#banana" transform="translate(1000,870) rotate(10)  scale(2.5)" fill="url(#g-teal)"/>
  <use href="#fan"    transform="translate(1180,864) rotate(14)  scale(2.6)" fill="url(#g-mid)"/>

