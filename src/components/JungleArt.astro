  <use href="#lf" transform="translate(1180,888) rotate(30) scale(2.3)" fill="url(#g-lime)"/>

  <!-- ════ RANA DARDO (hoja frontal izq) ════ -->
  <g transform="translate(372,806) scale(1.45)">
    <path d="M-14,6 C-25,10 -27,23 -18,25 C-14,19 -12,12 -10,8 Z" fill="#B83A0A"/>
