---
// Ilustración flat / paper-cut de la selva — estilo diseñador
// Base oscura Nasúa + follaje vibrante por capas + animales flat
// Protagonista: el coatí (nombre de la banda)
---

<svg
  class="jungle-art absolute inset-0 w-full h-full pointer-events-none"
  viewBox="0 0 1440 900"
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
>
  <defs>
    <!-- ── Degradados sutiles para dar volumen flat ── -->
    <linearGradient id="ja-mass-back" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0E3A1B"/>
      <stop offset="1" stop-color="#08220F"/>
    </linearGradient>
    <linearGradient id="ja-mass-mid" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1A5E2A"/>
      <stop offset="1" stop-color="#103A1B"/>
    </linearGradient>
    <linearGradient id="ja-mass-front" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2E9440"/>
      <stop offset="1" stop-color="#1A5E2A"/>
    </linearGradient>
    <linearGradient id="ja-mass-pop" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#46B857"/>
      <stop offset="1" stop-color="#2E9440"/>
    </linearGradient>
    <linearGradient id="ja-beak" x1="0" y1="0" x2="1" y2="0.3">
      <stop offset="0"   stop-color="#F5A24A"/>
      <stop offset="0.55" stop-color="#E8681C"/>
      <stop offset="1"   stop-color="#C0480C"/>
    </linearGradient>
    <radialGradient id="ja-sun" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#F2C53D" stop-opacity="0.16"/>
      <stop offset="1" stop-color="#F2C53D" stop-opacity="0"/>
    </radialGradient>

    <!-- ── Símbolos de hoja (centrados en origen, apuntando arriba) ── -->
    <g id="ja-leaf">
      <path d="M0,-30 C13,-22 14,16 0,30 C-14,16 -13,-22 0,-30 Z"/>
      <path d="M0,-25 L0,26" stroke="#000" stroke-opacity="0.12" stroke-width="1.6" fill="none"/>
    </g>

    <g id="ja-mon">
      <path d="M0,60 C-24,54 -42,40 -48,18 C-50,9 -41,13 -37,17
               C-46,3 -48,-15 -38,-28 C-32,-36 -27,-27 -23,-32
               C-31,-44 -25,-56 -10,-62 C-5,-64 -2,-58 0,-59
               C2,-58 5,-64 10,-62 C25,-56 31,-44 23,-32
               C27,-27 32,-36 38,-28 C48,-15 46,3 37,17
               C41,13 50,9 48,18 C42,40 24,54 0,60 Z"/>
      <ellipse cx="-20" cy="-6" rx="7.5" ry="14" fill="#000" fill-opacity="0.3" transform="rotate(-14 -20 -6)"/>
      <ellipse cx="20"  cy="-6" rx="7.5" ry="14" fill="#000" fill-opacity="0.3" transform="rotate(14 20 -6)"/>
      <ellipse cx="-13" cy="26" rx="6"  ry="10" fill="#000" fill-opacity="0.28"/>
      <ellipse cx="13"  cy="26" rx="6"  ry="10" fill="#000" fill-opacity="0.28"/>
      <path d="M0,-56 L0,54" stroke="#000" stroke-opacity="0.13" stroke-width="2.2" fill="none"/>
    </g>

    <g id="ja-frond">
      <use href="#ja-leaf" transform="translate(0,-34) scale(1.05,1.5)"/>
      <use href="#ja-leaf" transform="rotate(-26) translate(0,-32) scale(0.92,1.3)"/>
      <use href="#ja-leaf" transform="rotate(26)  translate(0,-32) scale(0.92,1.3)"/>
      <use href="#ja-leaf" transform="rotate(-50) translate(0,-28) scale(0.82,1.15)"/>
      <use href="#ja-leaf" transform="rotate(50)  translate(0,-28) scale(0.82,1.15)"/>
      <use href="#ja-leaf" transform="rotate(-72) translate(0,-22) scale(0.7,1)"/>
      <use href="#ja-leaf" transform="rotate(72)  translate(0,-22) scale(0.7,1)"/>
    </g>

    <!-- Helecho (frond con foliolos) -->
    <g id="ja-fern">
      <path d="M0,40 C-2,10 -2,-20 0,-48" stroke="#000" stroke-opacity="0.15" stroke-width="2" fill="none"/>
      <g>
        <ellipse cx="-9"  cy="30"  rx="9"  ry="3.5" fill="inherit" transform="rotate(28 -9 30)"/>
        <ellipse cx="9"   cy="30"  rx="9"  ry="3.5" transform="rotate(-28 9 30)"/>
        <ellipse cx="-9"  cy="14"  rx="10" ry="3.5" transform="rotate(28 -9 14)"/>
        <ellipse cx="9"   cy="14"  rx="10" ry="3.5" transform="rotate(-28 9 14)"/>
        <ellipse cx="-8"  cy="-2"  rx="9"  ry="3.2" transform="rotate(28 -8 -2)"/>
        <ellipse cx="8"   cy="-2"  rx="9"  ry="3.2" transform="rotate(-28 8 -2)"/>
        <ellipse cx="-6"  cy="-18" rx="7"  ry="3"   transform="rotate(28 -6 -18)"/>
        <ellipse cx="6"   cy="-18" rx="7"  ry="3"   transform="rotate(-28 6 -18)"/>
        <ellipse cx="-4"  cy="-32" rx="5"  ry="2.5" transform="rotate(28 -4 -32)"/>
        <ellipse cx="4"   cy="-32" rx="5"  ry="2.5" transform="rotate(-28 4 -32)"/>
      </g>
    </g>

    <!-- Flor naranja (acento de marca) -->
    <g id="ja-bloom">
      <ellipse cx="0"  cy="-9" rx="5" ry="10" fill="#E8681C"/>
      <ellipse cx="9"  cy="-3" rx="9" ry="5"  fill="#F5A24A" transform="rotate(35 9 -3)"/>
      <ellipse cx="-9" cy="-3" rx="9" ry="5"  fill="#F5A24A" transform="rotate(-35 -9 -3)"/>
      <ellipse cx="6"  cy="7"  rx="5" ry="9"  fill="#E8681C" transform="rotate(48 6 7)"/>
      <ellipse cx="-6" cy="7"  rx="5" ry="9"  fill="#E8681C" transform="rotate(-48 -6 7)"/>
      <circle  cx="0"  cy="0"  r="4"          fill="#F2C53D"/>
    </g>

    <!-- Sprig decorativo (rama con par de hojitas) -->
    <g id="ja-sprig">
      <path d="M0,0 C6,-14 10,-28 12,-44" stroke="#2E9440" stroke-width="2.5" fill="none" stroke-linecap="round"/>
      <use href="#ja-leaf" transform="translate(6,-16) rotate(45) scale(0.5)"   fill="#2E9440"/>
      <use href="#ja-leaf" transform="translate(2,-10) rotate(-50) scale(0.45)" fill="#46B857"/>
      <use href="#ja-leaf" transform="translate(10,-30) rotate(40) scale(0.42)" fill="#46B857"/>
      <use href="#ja-leaf" transform="translate(7,-24) rotate(-46) scale(0.4)"  fill="#2E9440"/>
      <use href="#ja-leaf" transform="translate(12,-44) rotate(8)  scale(0.4)"  fill="#58C969"/>
    </g>
  </defs>

  <!-- ════ FONDO: dosel lejano (verdes más oscuros) ════ -->
  <ellipse cx="180"  cy="-50"  rx="380" ry="210" fill="#08220F"/>
  <ellipse cx="720"  cy="-90"  rx="460" ry="220" fill="#061A0B"/>
  <ellipse cx="1260" cy="-50"  rx="400" ry="210" fill="#08220F"/>
  <ellipse cx="980"  cy="-110" rx="300" ry="170" fill="#04140A"/>
  <ellipse cx="420"  cy="-100" rx="260" ry="150" fill="#04140A"/>

  <!-- Resplandor cálido (luz que entra por el dosel) -->
  <ellipse cx="720" cy="60"  rx="560" ry="340" fill="url(#ja-sun)"/>
  <ellipse cx="360" cy="120" rx="220" ry="320" fill="url(#ja-sun)" transform="rotate(-16 360 120)"/>

  <!-- Rayos de luz diagonales -->
  <polygon points="430,-40 520,-40 360,560 290,560" fill="#F2C53D" opacity="0.035"/>
  <polygon points="760,-40 820,-40 700,520 650,520" fill="#F2C53D" opacity="0.03"/>

  <!-- ════ LIANAS colgantes ════ -->
  <path d="M300,-20 C290,120 312,260 300,400" stroke="#0E3A1B" stroke-width="4" fill="none" opacity="0.8"/>
  <path d="M340,-20 C352,110 330,240 344,360" stroke="#0E3A1B" stroke-width="3" fill="none" opacity="0.7"/>
  <path d="M1120,-20 C1132,130 1108,270 1124,410" stroke="#0E3A1B" stroke-width="4" fill="none" opacity="0.8"/>
  <path d="M1170,-20 C1158,120 1182,250 1166,380" stroke="#0E3A1B" stroke-width="3" fill="none" opacity="0.65"/>
  <path d="M720,-20 C712,90 728,200 720,300" stroke="#0E3A1B" stroke-width="2.5" fill="none" opacity="0.5"/>
  <!-- Hojitas en las lianas -->
  <use href="#ja-leaf" transform="translate(300,180) rotate(40) scale(0.6)"  fill="#13491F"/>
  <use href="#ja-leaf" transform="translate(344,260) rotate(-44) scale(0.55)" fill="#13491F"/>
  <use href="#ja-leaf" transform="translate(1124,210) rotate(-40) scale(0.6)" fill="#13491F"/>
  <use href="#ja-leaf" transform="translate(1166,290) rotate(46) scale(0.55)" fill="#13491F"/>

  <!-- ════ PARED IZQUIERDA (sube desde abajo-izq) ════ -->
  <use href="#ja-mon"   transform="translate(110,650) rotate(-12) scale(2.6)" fill="url(#ja-mass-back)"/>
  <use href="#ja-frond" transform="translate(55,740)  rotate(-32) scale(2.4)" fill="#103A1B"/>
  <use href="#ja-mon"   transform="translate(195,710) rotate(14)  scale(2.1)" fill="#13491F"/>
  <use href="#ja-frond" transform="translate(150,690) rotate(8)   scale(2.0)" fill="url(#ja-mass-mid)"/>
  <use href="#ja-fern"  transform="translate(95,690)  rotate(-14) scale(2.2)" fill="#1A5E2A"/>

  <!-- ════ PARED DERECHA (sube desde abajo-der) ════ -->
  <use href="#ja-mon"   transform="translate(1330,660) rotate(12)  scale(2.6)" fill="url(#ja-mass-back)"/>
  <use href="#ja-frond" transform="translate(1385,745) rotate(32)  scale(2.4)" fill="#103A1B"/>
  <use href="#ja-mon"   transform="translate(1250,715) rotate(-14) scale(2.1)" fill="#13491F"/>
  <use href="#ja-frond" transform="translate(1300,695) rotate(-8)  scale(2.0)" fill="url(#ja-mass-mid)"/>
  <use href="#ja-fern"  transform="translate(1350,695) rotate(14)  scale(2.2)" fill="#1A5E2A"/>

  <!-- ════ ANIMAL: TUCÁN (arriba-izq, sobre liana) ════ -->
  <g transform="translate(322,200) scale(1.7)">
    <!-- Cola -->
    <path d="M-28,12 L-50,30 C-54,34 -48,40 -43,36 L-20,22 Z" fill="#161616"/>
    <!-- Cuerpo -->
    <ellipse cx="0" cy="6" rx="29" ry="25" fill="#1A1A1A"/>
    <!-- Pecho amarillo + naranja -->
    <path d="M-7,-12 C-21,-6 -23,18 -9,27 C3,23 4,-7 -7,-12 Z" fill="#F2C53D"/>
    <path d="M-9,24 C-3,29 7,27 10,20 C3,25 -4,26 -9,24 Z" fill="#E8681C"/>
    <!-- Cabeza -->
    <circle cx="13" cy="-17" r="19" fill="#1A1A1A"/>
    <!-- Ojo con anillo -->
    <circle cx="21" cy="-21" r="8"   fill="#2E7E96"/>
    <circle cx="22" cy="-21" r="5"   fill="#EDE8E0"/>
    <circle cx="23" cy="-21" r="2.6" fill="#0A0A0A"/>
    <!-- PICO -->
    <path d="M29,-26 C62,-31 82,-20 84,-7 C82,3 58,3 33,-5 C27,-12 25,-22 29,-26 Z" fill="url(#ja-beak)"/>
    <path d="M30,-25 C50,-27 70,-24 82,-11" stroke="#C0480C" stroke-width="1.4" fill="none" opacity="0.5"/>
    <path d="M33,-5 C29,-13 29,-22 31,-25" stroke="#0A0A0A" stroke-width="2" fill="none" opacity="0.25"/>
    <!-- Patas -->
    <path d="M-6,29 L-6,39 M-6,39 L-12,45 M-6,39 L0,45" stroke="#E8681C" stroke-width="2.4" stroke-linecap="round" fill="none"/>
    <path d="M9,29 L9,39 M9,39 L3,45 M9,39 L15,45"      stroke="#E8681C" stroke-width="2.4" stroke-linecap="round" fill="none"/>
  </g>

  <!-- ════ ANIMAL: COATÍ (protagonista, zona abierta derecha, mira al centro) ════ -->
  <g transform="translate(1196,652) scale(-1.62,1.62)">
    <!-- Cola larga anillada, levantada y curvada (rasgo más icónico) -->
    <path d="M-44,-4 C-78,-24 -88,-82 -64,-124 C-50,-150 -20,-154 -12,-130"
          fill="none" stroke="#3A2614" stroke-width="22" stroke-linecap="round"/>
    <path d="M-44,-4 C-78,-24 -88,-82 -64,-124 C-50,-150 -20,-154 -12,-130"
          fill="none" stroke="#7A5028" stroke-width="22" stroke-linecap="round" stroke-dasharray="4 22"/>
    <circle cx="-13" cy="-131" r="11" fill="#241608"/>

    <!-- Cadera (más oscura, atrás) -->
    <ellipse cx="-28" cy="6" rx="40" ry="36" fill="#34220F"/>
    <!-- Cuerpo -->
    <ellipse cx="12" cy="2" rx="48" ry="32" fill="#4A3018"/>
    <!-- Luz en el lomo (da forma) -->
    <path d="M-22,-24 C0,-34 32,-33 54,-20" stroke="#7A5028" stroke-width="3.5" fill="none" opacity="0.45" stroke-linecap="round"/>
    <!-- Sombra de vientre -->
    <ellipse cx="2" cy="24" rx="46" ry="13" fill="#2A1A0C" opacity="0.55"/>

    <!-- Patas oscuras (clara separación del cuerpo) -->
    <path d="M34,24 L31,58 C31,64 45,64 45,58 L47,26 Z" fill="#241608"/>
    <path d="M6,28 L3,60 C3,66 16,66 16,60 L18,28 Z"     fill="#2E1D0E"/>
    <ellipse cx="-30" cy="42" rx="17" ry="10" fill="#241608"/>

    <!-- Cuello hacia la cabeza -->
    <path d="M44,-8 C54,-26 62,-38 74,-44 L72,2 C60,6 50,4 44,-8 Z" fill="#4A3018"/>

    <!-- Cabeza (pequeña) -->
    <circle cx="74" cy="-44" r="17" fill="#4A3018"/>
    <!-- Oreja redonda -->
    <path d="M66,-58 C63,-70 76,-72 82,-62 C79,-56 72,-56 66,-58 Z" fill="#2E1D0E"/>
    <ellipse cx="73" cy="-61" rx="4" ry="5" fill="#1A0E04" opacity="0.5"/>

    <!-- HOCICO largo y delgado, hacia arriba (rasgo clave del coatí), más claro -->
    <path d="M86,-48 C112,-54 140,-58 158,-56 C163,-55 163,-49 158,-48
             C140,-46 116,-42 92,-38 C84,-42 82,-46 86,-48 Z" fill="#6E4A28"/>
    <path d="M96,-50 C120,-54 144,-57 158,-55 C150,-58 120,-57 96,-50 Z" fill="#8A6238" opacity="0.7"/>
    <!-- Nariz negra en la punta -->
    <ellipse cx="159" cy="-52" rx="7" ry="6" fill="#160C04"/>
    <!-- Línea de boca -->
    <path d="M92,-37 C112,-40 134,-44 154,-48" stroke="#241608" stroke-width="2" fill="none" opacity="0.4" stroke-linecap="round"/>

    <!-- Máscara facial clara (rasgo del coatí) -->
    <path d="M64,-48 C72,-52 82,-50 88,-45" stroke="#B89060" stroke-width="3.5" fill="none" opacity="0.55" stroke-linecap="round"/>
    <!-- Ojo -->
    <circle cx="72" cy="-46" r="4.4" fill="#140A03"/>
    <circle cx="73.6" cy="-47.6" r="1.5" fill="#EDE8E0" fill-opacity="0.8"/>
  </g>

  <!-- Mata frente al coatí — lo asienta en la selva (asoma entre arbustos) -->
  <use href="#ja-fern" transform="translate(1196,710) rotate(8) scale(2.0)" fill="#1A5E2A"/>
  <use href="#ja-mon"  transform="translate(1132,726) rotate(-12) scale(1.8)" fill="url(#ja-mass-front)"/>
  <use href="#ja-leaf" transform="translate(1248,716) rotate(22) scale(1.7)" fill="#46B857"/>
  <use href="#ja-bloom" transform="translate(1256,700) scale(1.2)"/>

  <!-- ════ BANDA INFERIOR — capas back→front ════ -->
  <!-- Capa atrás -->
  <use href="#ja-mon"   transform="translate(420,790)  rotate(-8)  scale(2.3)" fill="#103A1B"/>
  <use href="#ja-mon"   transform="translate(640,800)  rotate(6)   scale(2.4)" fill="#13491F"/>
  <use href="#ja-mon"   transform="translate(860,795)  rotate(-6)  scale(2.3)" fill="#103A1B"/>
  <use href="#ja-mon"   transform="translate(1060,800) rotate(8)   scale(2.4)" fill="#13491F"/>
  <use href="#ja-fern"  transform="translate(540,770)  rotate(-10) scale(2.3)" fill="#1A5E2A"/>
  <use href="#ja-fern"  transform="translate(960,775)  rotate(10)  scale(2.3)" fill="#1A5E2A"/>

  <!-- Capa media (vibrante) -->
  <use href="#ja-mon"   transform="translate(330,850)  rotate(-14) scale(2.5)" fill="url(#ja-mass-mid)"/>
  <use href="#ja-frond" transform="translate(520,860)  rotate(-6)  scale(2.5)" fill="#1A5E2A"/>
  <use href="#ja-mon"   transform="translate(720,860)  rotate(4)   scale(2.6)" fill="url(#ja-mass-front)"/>
  <use href="#ja-frond" transform="translate(920,860)  rotate(8)   scale(2.5)" fill="#1A5E2A"/>
  <use href="#ja-mon"   transform="translate(1120,852) rotate(14)  scale(2.5)" fill="url(#ja-mass-mid)"/>

  <!-- Capa frente (más brillante y grande) -->
  <use href="#ja-mon"   transform="translate(180,900)  rotate(-18) scale(2.9)" fill="url(#ja-mass-front)"/>
  <use href="#ja-frond" transform="translate(440,910)  rotate(-10) scale(2.8)" fill="#2E9440"/>
  <use href="#ja-mon"   transform="translate(720,915)  rotate(2)   scale(3.0)" fill="url(#ja-mass-pop)"/>
  <use href="#ja-frond" transform="translate(1000,910) rotate(10)  scale(2.8)" fill="#2E9440"/>
  <use href="#ja-mon"   transform="translate(1270,900) rotate(18)  scale(2.9)" fill="url(#ja-mass-front)"/>

  <!-- Hojas-lanza altas (rompen la línea plana, dan silueta dinámica) -->
  <use href="#ja-leaf"  transform="translate(360,855) rotate(-7) scale(1.05,3.4)" fill="#13491F"/>
  <use href="#ja-leaf"  transform="translate(478,862) rotate(5)  scale(0.95,2.9)" fill="#1A5E2A"/>
  <use href="#ja-leaf"  transform="translate(596,858) rotate(-4) scale(1.0,3.1)"  fill="#13491F"/>
  <use href="#ja-leaf"  transform="translate(806,860) rotate(6)  scale(0.95,2.8)" fill="#1A5E2A"/>
  <use href="#ja-leaf"  transform="translate(980,856) rotate(-5) scale(1.05,3.3)" fill="#13491F"/>
  <use href="#ja-leaf"  transform="translate(1095,862) rotate(7) scale(0.95,2.9)" fill="#1A5E2A"/>

  <!-- Acentos lima frontales -->
  <use href="#ja-leaf"  transform="translate(280,880) rotate(-30) scale(2.4)" fill="#58C969"/>
  <use href="#ja-leaf"  transform="translate(1180,885) rotate(32) scale(2.4)" fill="#58C969"/>
  <use href="#ja-leaf"  transform="translate(620,895) rotate(-12) scale(2.0)" fill="#46B857"/>
  <use href="#ja-leaf"  transform="translate(840,895) rotate(12)  scale(2.0)" fill="#46B857"/>

  <!-- ════ ANIMAL: RANA DARDO (acento, hoja frontal izq) ════ -->
  <g transform="translate(372,806) scale(1.45)">
    <path d="M-14,6 C-25,10 -27,23 -18,25 C-14,19 -12,12 -10,8 Z" fill="#C0480C"/>
    <path d="M14,6 C25,10 27,23 18,25 C14,19 12,12 10,8 Z"        fill="#C0480C"/>
    <ellipse cx="0" cy="2" rx="18" ry="14" fill="#E8681C"/>
    <ellipse cx="0" cy="8" rx="11" ry="7"  fill="#F5A24A"/>
    <path d="M-10,12 C-16,18 -16,24 -10,22" stroke="#C0480C" stroke-width="4" fill="none" stroke-linecap="round"/>
    <path d="M10,12 C16,18 16,24 10,22"     stroke="#C0480C" stroke-width="4" fill="none" stroke-linecap="round"/>
    <circle cx="-9" cy="-12" r="8" fill="#F5A24A"/>
    <circle cx="9"  cy="-12" r="8" fill="#F5A24A"/>
    <circle cx="-9" cy="-12" r="5" fill="#160C04"/>
    <circle cx="9"  cy="-12" r="5" fill="#160C04"/>
    <circle cx="-7" cy="-14" r="1.6" fill="#fff" fill-opacity="0.85"/>
    <circle cx="11" cy="-14" r="1.6" fill="#fff" fill-opacity="0.85"/>
    <circle cx="-5" cy="3" r="2.4" fill="#7A2D08" fill-opacity="0.55"/>
    <circle cx="7"  cy="5" r="2"   fill="#7A2D08" fill-opacity="0.55"/>
  </g>

  <!-- ════ FLORES naranja (acentos de marca) ════ -->
  <use href="#ja-bloom" transform="translate(208,712) scale(1.5)"/>
  <use href="#ja-bloom" transform="translate(404,832) scale(1.3)"/>
  <use href="#ja-bloom" transform="translate(1276,700) scale(1.5)"/>
  <use href="#ja-bloom" transform="translate(1052,840) scale(1.3)"/>
  <use href="#ja-bloom" transform="translate(690,872) scale(1.2)"/>

  <!-- ════ SPRIGS decorativos flotantes (espacio abierto) ════ -->
  <!-- Posición en el <g> exterior; la animación va en el <use> interior
       para no sobrescribir el transform de posición -->
  <g transform="translate(1180,150) rotate(20)  scale(1.5)"><use href="#ja-sprig" class="float-leaf"/></g>
  <g transform="translate(1290,250) rotate(-30) scale(1.2)"><use href="#ja-sprig" class="float-leaf-2"/></g>
  <g transform="translate(150,180)  rotate(-24) scale(1.3)"><use href="#ja-sprig" class="float-leaf"/></g>
  <g transform="translate(95,300)   rotate(18)  scale(1.0)"><use href="#ja-sprig" class="float-leaf-2"/></g>

  <!-- Viñeta inferior para fundir con el fondo -->
  <rect x="0" y="760" width="1440" height="140" fill="#030803" opacity="0.35"/>
</svg>
