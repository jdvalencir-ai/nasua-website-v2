  <use href="#fan"    transform="translate(360,800)  rotate(-8)  scale(2.4)" fill="#103A1B"/>
  <use href="#mon"    transform="translate(560,810)  rotate(8)   scale(2.5)" fill="#13491F"/>
  <use href="#banana" transform="translate(720,800)  rotate(-4)  scale(2.6)" fill="#103A1B"/>
  <use href="#fan"    transform="translate(900,808)  rotate(10)  scale(2.4)" fill="#13491F"/>
  <use href="#mon"    transform="translate(1080,805) rotate(-8)  scale(2.5)" fill="#103A1B"/>
  <use href="#fern"   transform="translate(460,780)  rotate(-12) scale(2.4)" fill="#1A5E2A"/>
  <use href="#fern"   transform="translate(1000,785) rotate(12)  scale(2.4)" fill="#1A5E2A"/>

  <!-- Juncos altos (silueta dinámica) -->
  <use href="#reed" transform="translate(300,830) rotate(-6) scale(2.0)" fill="#1A5E2A"/>
