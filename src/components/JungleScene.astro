---
interface Props {
  variant?: 'hero' | 'section' | 'footer';
}
const { variant = 'hero' } = Astro.props;
---

{variant === 'hero' && (
  <div class="jungle-scene absolute bottom-0 left-0 right-0 pointer-events-none" aria-hidden="true"
       style="height: 520px; overflow: visible;">

    <!-- ── Canopy glow — warm amber light from above ── -->
    <div class="absolute left-1/2 -translate-x-1/2"
         style="bottom: 380px; width: 70%; height: 300px;
                background: radial-gradient(ellipse at 50% 0%, rgba(180,90,10,0.13) 0%, transparent 70%);
                pointer-events:none;">
    </div>

    <!-- ── Light shafts (angled CSS divs) ── -->
    <div class="jungle-ray absolute"
         style="bottom: 0; left: 28%; width: 120px; height: 480px;
                background: linear-gradient(to bottom, rgba(200,110,20,0.07) 0%, transparent 100%);
                transform: rotate(-18deg); transform-origin: top center;
                filter: blur(18px);">
    </div>
    <div class="jungle-ray-2 absolute"
         style="bottom: 0; left: 48%; width: 90px; height: 420px;
                background: linear-gradient(to bottom, rgba(200,110,20,0.055) 0%, transparent 100%);
                transform: rotate(8deg); transform-origin: top center;
                filter: blur(22px);">
    </div>
    <div class="jungle-ray absolute"
         style="bottom: 0; right: 22%; width: 100px; height: 400px;
                background: linear-gradient(to bottom, rgba(180,100,15,0.06) 0%, transparent 100%);
                transform: rotate(22deg); transform-origin: top center;
                filter: blur(20px);">
    </div>

    <!-- ══ LEFT SIDE FOLIAGE ══════════════════════════ -->
    <svg class="absolute left-0 bottom-0 float-leaf" viewBox="0 0 600 520"
         style="height: 520px; width: auto; min-width: 320px; animation-duration: 10s;">

      <!-- Back palm trunk -->
      <path d="M-30 520 C10 420 30 310 80 200 C120 110 170 60 185 80"
            stroke="#071507" stroke-width="22" fill="none" stroke-linecap="round"/>
      <path d="M-30 520 C10 420 30 310 80 200 C120 110 170 60 185 80"
            stroke="#0A1E0A" stroke-width="10" fill="none" stroke-linecap="round"/>

      <!-- Palm fronds from left trunk — multiple blades -->
      <!-- Frond 1: sweeps up-right -->
      <path d="M185 80 C230 40 310 20 340 50 C280 60 230 80 185 80 Z" fill="#071A07"/>
      <path d="M185 80 C240 30 330 10 365 38 C300 52 240 72 185 80 Z" fill="#0A2010" opacity="0.7"/>
      <!-- Frond 2: sweeps up-left -->
      <path d="M185 80 C150 30 80 10 50 38 C100 55 148 72 185 80 Z" fill="#071A07"/>
      <path d="M185 80 C140 20 60 0 20 30 C80 50 135 70 185 80 Z" fill="#0A2010" opacity="0.7"/>
      <!-- Frond 3: nearly vertical up -->
      <path d="M185 80 C190 30 195 -20 185 -50 C175 -20 172 30 185 80 Z" fill="#081808"/>
      <!-- Frond 4: diagonals -->
      <path d="M185 80 C210 20 250 -10 270 15 C235 35 205 62 185 80 Z" fill="#0D2A0D" opacity="0.8"/>
      <path d="M185 80 C160 20 120 0 100 25 C135 45 165 65 185 80 Z"   fill="#0D2A0D" opacity="0.8"/>
      <!-- Frond midrib lines -->
      <path d="M185 80 C250 45 320 32 348 48" stroke="#071507" stroke-width="2.5" fill="none" opacity="0.6"/>
      <path d="M185 80 C135 40 80 22 52 37"   stroke="#071507" stroke-width="2.5" fill="none" opacity="0.6"/>

      <!-- BANANA LEAF — massive, left foreground -->
      <!-- Main shape: oval with pointed tip, angled to right -->
      <path d="M-40 420 C20 380 100 300 160 210 C200 155 220 120 210 100 C195 80 165 95 140 130
               C100 185 55 270 10 360 C-15 405 -35 430 -40 420 Z"
            fill="#0B2B0B"/>
      <!-- Midrib -->
      <path d="M-40 420 C0 380 80 300 145 210 C185 155 210 115 210 100"
            stroke="#061206" stroke-width="4" fill="none" stroke-linecap="round"/>
      <!-- Lateral veins -->
      <path d="M60 340 C80 325 100 310 115 290" stroke="#071507" stroke-width="1.5" fill="none" opacity="0.5"/>
      <path d="M95 290 C115 275 130 260 145 240" stroke="#071507" stroke-width="1.5" fill="none" opacity="0.5"/>
      <path d="M130 240 C148 225 160 210 172 192" stroke="#071507" stroke-width="1.5" fill="none" opacity="0.5"/>
      <!-- Leaf edge tear detail -->
      <path d="M55 350 C42 345 35 338 38 330 C50 325 60 330 55 350 Z" fill="#0A2410" opacity="0.5"/>

      <!-- MONSTERA LEAF — mid-left -->
      <path d="M0 480 C15 430 40 370 80 310 C110 265 148 235 160 250
               C148 278 130 295 108 318 C80 348 50 395 30 450 Z"
            fill="#0D2D0D" opacity="0.9"/>
      <!-- Monstera holes (fenestrations) -->
      <ellipse cx="100" cy="295" rx="8" ry="13" fill="#060906" opacity="0.7" transform="rotate(-20, 100, 295)"/>
      <ellipse cx="120" cy="270" rx="6" ry="10" fill="#060906" opacity="0.6" transform="rotate(-25, 120, 270)"/>
      <!-- Monstera midrib -->
      <path d="M0 480 C40 420 90 350 145 265 C155 250 162 245 160 250"
            stroke="#071507" stroke-width="2.5" fill="none" opacity="0.5"/>

      <!-- Small alocasia / arrow leaf -->
      <path d="M60 480 C75 450 105 415 125 385 C140 360 148 340 140 332
               C125 328 110 342 95 365 C75 395 60 435 60 480 Z"
            fill="#112811" opacity="0.75"/>
      <path d="M62 478 C80 450 110 415 138 335" stroke="#071507" stroke-width="1.5" fill="none" opacity="0.4"/>

      <!-- Tucán (toucan) perched on left palm -->
      <g transform="translate(100, 125) scale(1.1)">
        <!-- Branch to stand on -->
        <path d="M-15 55 Q10 52 35 55" stroke="#0A1E0A" stroke-width="5" fill="none" stroke-linecap="round"/>
        <!-- Body -->
        <ellipse cx="8" cy="28" rx="24" ry="19" fill="#0C0C0C"/>
        <!-- Chest patch — white/yellow -->
        <ellipse cx="6" cy="30" rx="13" ry="16" fill="#E8D060" opacity="0.15"/>
        <ellipse cx="6" cy="30" rx="10" ry="13" fill="#F0EDE0" opacity="0.12"/>
        <!-- Head -->
        <circle cx="30" cy="10" r="17" fill="#0C0C0C"/>
        <!-- Eye ring (blue) -->
        <circle cx="35" cy="8" r="8" fill="#0D5A7A" opacity="0.6"/>
        <!-- Eye -->
        <circle cx="35" cy="8" r="5" fill="white" opacity="0.95"/>
        <circle cx="36" cy="8" r="3" fill="#0C0C0C"/>
        <circle cx="37" cy="7" r="1.2" fill="rgba(255,255,255,0.7)"/>
        <!-- TOUCAN BEAK — big and colorful -->
        <path d="M44 4 Q80 -4 86 12 Q84 26 44 26 Q36 18 36 12 Z" fill="#E8681C"/>
        <path d="M44 4 Q80 -4 86 12" stroke="#B44E0E" stroke-width="2" fill="none"/>
        <path d="M44 26 Q80 24 86 12" stroke="#8B3A0A" stroke-width="1" fill="none" opacity="0.5"/>
        <!-- Beak tip accent -->
        <path d="M82 10 Q86 12 82 16" stroke="#FFDD44" stroke-width="2" fill="none" opacity="0.4"/>
        <!-- Wing fold detail -->
        <path d="M-16 22 C-28 32 -26 50 -12 46 C-4 42 6 36 8 28 Z" fill="#111" opacity="0.8"/>
        <path d="M-16 22 C-28 34 -26 46 -12 46" stroke="#1A1A1A" stroke-width="1.5" fill="none"/>
        <!-- Tail -->
        <path d="M-24 40 Q-38 58 -44 52 Q-36 42 -24 40 Z" fill="#1C1C1C"/>
        <!-- Feet -->
        <path d="M0 47 L0 56 M0 56 L-8 63 M0 56 L4 63 M0 56 L8 60" stroke="#2A1A0A" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M14 47 L14 57 M14 57 L7 64 M14 57 L19 64 M14 57 L22 61" stroke="#2A1A0A" stroke-width="2.5" stroke-linecap="round"/>
      </g>
    </svg>

    <!-- ══ RIGHT SIDE FOLIAGE ═════════════════════════ -->
    <svg class="absolute right-0 bottom-0 float-leaf-r" viewBox="0 0 600 520"
         style="height: 520px; width: auto; min-width: 320px; animation-duration: 13s;">

      <!-- Back palm trunk (mirrored) -->
      <path d="M630 520 C590 420 570 310 520 200 C480 110 430 60 415 80"
            stroke="#071507" stroke-width="22" fill="none" stroke-linecap="round"/>
      <path d="M630 520 C590 420 570 310 520 200 C480 110 430 60 415 80"
            stroke="#0A1E0A" stroke-width="10" fill="none" stroke-linecap="round"/>

      <!-- Palm fronds from right trunk -->
      <path d="M415 80 C370 40 290 20 260 50 C320 60 370 80 415 80 Z" fill="#071A07"/>
      <path d="M415 80 C360 30 270 10 235 38 C300 52 360 72 415 80 Z"  fill="#0A2010" opacity="0.7"/>
      <path d="M415 80 C450 30 520 10 550 38 C500 55 452 72 415 80 Z"  fill="#071A07"/>
      <path d="M415 80 C460 20 540 0 580 30 C520 50 465 70 415 80 Z"   fill="#0A2010" opacity="0.7"/>
      <path d="M415 80 C410 30 405 -20 415 -50 C425 -20 428 30 415 80 Z" fill="#081808"/>
      <path d="M415 80 C390 20 350 -10 330 15 C365 35 395 62 415 80 Z"  fill="#0D2A0D" opacity="0.8"/>
      <!-- Frond midrib lines -->
      <path d="M415 80 C350 45 280 32 252 48" stroke="#071507" stroke-width="2.5" fill="none" opacity="0.6"/>
      <path d="M415 80 C465 40 520 22 548 37"  stroke="#071507" stroke-width="2.5" fill="none" opacity="0.6"/>

      <!-- LARGE BANANA LEAF — right foreground (mirror) -->
      <path d="M640 420 C580 380 500 300 440 210 C400 155 380 120 390 100 C405 80 435 95 460 130
               C500 185 545 270 590 360 C615 405 635 430 640 420 Z"
            fill="#0B2B0B"/>
      <path d="M640 420 C600 380 520 300 455 210 C415 155 390 115 390 100"
            stroke="#061206" stroke-width="4" fill="none" stroke-linecap="round"/>
      <path d="M540 340 C520 325 500 310 485 290" stroke="#071507" stroke-width="1.5" fill="none" opacity="0.5"/>
      <path d="M505 290 C485 275 470 260 455 240" stroke="#071507" stroke-width="1.5" fill="none" opacity="0.5"/>
      <path d="M470 240 C452 225 440 210 428 192" stroke="#071507" stroke-width="1.5" fill="none" opacity="0.5"/>

      <!-- MONSTERA right -->
      <path d="M600 480 C585 430 560 370 520 310 C490 265 452 235 440 250
               C452 278 470 295 492 318 C520 348 550 395 570 450 Z"
            fill="#0D2D0D" opacity="0.9"/>
      <ellipse cx="500" cy="295" rx="8" ry="13" fill="#060906" opacity="0.7" transform="rotate(20, 500, 295)"/>
      <ellipse cx="480" cy="270" rx="6" ry="10" fill="#060906" opacity="0.6" transform="rotate(25, 480, 270)"/>
      <path d="M600 480 C560 420 510 350 455 265 C445 250 438 245 440 250"
            stroke="#071507" stroke-width="2.5" fill="none" opacity="0.5"/>

      <!-- Arrow leaf right -->
      <path d="M540 480 C525 450 495 415 475 385 C460 360 452 340 460 332
               C475 328 490 342 505 365 C525 395 540 435 540 480 Z"
            fill="#112811" opacity="0.75"/>

      <!-- COATÍ peeking from right foliage -->
      <g transform="translate(450, 215) scale(-1, 1)">
        <!-- Ringed tail curving up -->
        <path d="M-5 -55 C-8 -85 2 -105 18 -95 C34 -85 30 -65 15 -60 C5 -57 -5 -55 -5 -55"
              stroke="#1A1A1A" stroke-width="12" fill="none" stroke-linecap="round"/>
        <!-- Ring pattern on tail -->
        <path d="M-5 -55 C-8 -85 2 -105 18 -95 C34 -85 30 -65 15 -60"
              stroke="#3A3A3A" stroke-width="4" fill="none" stroke-dasharray="8 8" stroke-linecap="round"/>
        <!-- Body -->
        <ellipse cx="0" cy="0" rx="33" ry="22" fill="#1A1A1A"/>
        <!-- Fur texture lines -->
        <path d="M-20 -12 C-10 -15 5 -14 18 -10" stroke="#252525" stroke-width="2" fill="none" opacity="0.6"/>
        <path d="M-22 0 C-10 -3 5 -2 20 2"        stroke="#252525" stroke-width="2" fill="none" opacity="0.6"/>
        <!-- Head with long snout (coatí characteristic) -->
        <ellipse cx="36" cy="-8" rx="22" ry="16" fill="#141414"/>
        <ellipse cx="56" cy="-5" rx="14" ry="8" fill="#1E1E1E"/>
        <!-- Facial mask markings (white spots above eyes) -->
        <ellipse cx="40" cy="-17" rx="4" ry="3" fill="rgba(255,255,255,0.18)"/>
        <ellipse cx="52" cy="-14" rx="3" ry="2" fill="rgba(255,255,255,0.12)"/>
        <!-- Lower facial marking -->
        <path d="M38 2 Q48 6 56 2" stroke="rgba(255,255,255,0.12)" stroke-width="3" fill="none" stroke-linecap="round"/>
        <!-- Eye -->
        <circle cx="42" cy="-12" r="5" fill="white" opacity="0.8"/>
        <circle cx="43" cy="-12" r="3.5" fill="#0A0A0A"/>
        <circle cx="44" cy="-13" r="1.3" fill="rgba(255,255,255,0.6)"/>
        <!-- Nose pad -->
        <ellipse cx="67" cy="-4" rx="6" ry="4" fill="#2A2A2A"/>
        <ellipse cx="67" cy="-4" rx="3" ry="2" fill="#1A1A1A"/>
        <!-- Nostril dots -->
        <circle cx="65" cy="-5" r="1" fill="#111"/>
        <circle cx="69" cy="-5" r="1" fill="#111"/>
        <!-- Legs -->
        <line x1="-18" y1="20" x2="-22" y2="40" stroke="#161616" stroke-width="6" stroke-linecap="round"/>
        <line x1="-5"  y1="21" x2="-5"  y2="42" stroke="#161616" stroke-width="6" stroke-linecap="round"/>
        <line x1="10"  y1="21" x2="12"  y2="42" stroke="#161616" stroke-width="6" stroke-linecap="round"/>
        <!-- Front paws -->
        <path d="M-22 40 L-26 47 L-19 47" stroke="#222" stroke-width="2" fill="#1A1A1A" stroke-linecap="round"/>
        <path d="M-5 42 L-9 49 L-2 49"    stroke="#222" stroke-width="2" fill="#1A1A1A" stroke-linecap="round"/>
      </g>
    </svg>

    <!-- ══ GROUND FOLIAGE — center undergrowth ══════ -->
    <svg class="absolute bottom-0 left-0 right-0" viewBox="0 0 1400 180" preserveAspectRatio="xMidYMax meet"
         style="width: 100%; height: 180px;">
      <!-- Grass / undergrowth blades left -->
      <path d="M80 180 C75 130 65 90 50 60 C70 85 90 120 95 180 Z" fill="#071507" opacity="0.8"/>
      <path d="M120 180 C118 135 112 100 100 72 C118 95 132 128 135 180 Z" fill="#0A1E0A" opacity="0.7"/>
      <path d="M55 180 C53 145 48 115 38 88 C54 110 62 140 65 180 Z" fill="#071507" opacity="0.6"/>

      <!-- Center ferns -->
      <path d="M650 180 C645 150 635 115 610 90 C640 108 658 142 665 180 Z" fill="#071507" opacity="0.5"/>
      <path d="M720 180 C718 155 713 128 703 105 C720 122 730 148 734 180 Z" fill="#0A1E0A" opacity="0.5"/>
      <path d="M680 180 C678 158 672 135 658 112 C675 128 684 152 688 180 Z" fill="#071507" opacity="0.4"/>

      <!-- Grass right -->
      <path d="M1280 180 C1285 130 1295 90 1310 60 C1290 85 1270 120 1265 180 Z" fill="#071507" opacity="0.8"/>
      <path d="M1320 180 C1322 135 1328 100 1340 72 C1322 95 1308 128 1305 180 Z" fill="#0A1E0A" opacity="0.7"/>
      <path d="M1250 180 C1252 145 1258 115 1268 88 C1252 110 1244 140 1241 180 Z" fill="#0A1E0A" opacity="0.6"/>

      <!-- Ground shadow/earth tone -->
      <rect x="0" y="150" width="1400" height="30" fill="#050D05" opacity="0.6"/>
    </svg>

    <!-- ══ GROUND MIST LAYERS ══════════════════════ -->
    <div class="jungle-mist absolute bottom-0 left-0 right-0"
         style="height: 90px;
                background: linear-gradient(to top, rgba(5,10,5,0.9) 0%, rgba(8,18,8,0.6) 40%, transparent 100%);
                filter: blur(4px);">
    </div>
    <div class="jungle-mist-2 absolute bottom-0 left-0 right-0"
         style="height: 120px;
                background: radial-gradient(ellipse 90% 100% at 50% 100%, rgba(10,25,10,0.5) 0%, transparent 70%);
                filter: blur(8px);">
    </div>

    <!-- ══ FIREFLIES ══════════════════════════════ -->
    <div class="firefly absolute"
         style="bottom: 200px; left: 35%; width: 4px; height: 4px; border-radius: 50%;
                background: rgba(220,255,120,0.9); box-shadow: 0 0 8px 3px rgba(180,240,80,0.5);
                animation-delay: 0s; animation-duration: 5s;">
    </div>
    <div class="firefly absolute"
         style="bottom: 280px; left: 52%; width: 3px; height: 3px; border-radius: 50%;
                background: rgba(200,255,100,0.8); box-shadow: 0 0 6px 2px rgba(160,220,70,0.4);
                animation-delay: 1.5s; animation-duration: 7s;">
    </div>
    <div class="firefly absolute"
         style="bottom: 160px; right: 38%; width: 4px; height: 4px; border-radius: 50%;
                background: rgba(230,255,140,0.85); box-shadow: 0 0 7px 3px rgba(190,250,90,0.45);
                animation-delay: 3s; animation-duration: 6s;">
    </div>
    <div class="firefly absolute"
         style="bottom: 320px; left: 22%; width: 3px; height: 3px; border-radius: 50%;
                background: rgba(210,255,110,0.7); box-shadow: 0 0 6px 2px rgba(170,235,75,0.4);
                animation-delay: 0.8s; animation-duration: 8s;">
    </div>
    <div class="firefly absolute"
         style="bottom: 240px; right: 28%; width: 3px; height: 3px; border-radius: 50%;
                background: rgba(225,255,130,0.75); box-shadow: 0 0 5px 2px rgba(185,245,85,0.4);
                animation-delay: 2.2s; animation-duration: 6.5s;">
    </div>
  </div>
)}

{variant === 'section' && (
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <!-- Atmospheric jungle corner accent -->
    <svg class="absolute left-0 bottom-0 opacity-40" viewBox="0 0 300 400" style="height: 400px; width: auto;">
      <path d="M-20 400 C10 340 40 260 85 185 C120 120 165 80 175 100 C160 140 130 200 100 280 C75 340 50 375 -20 400 Z"
            fill="#071A07"/>
      <path d="M-20 400 C20 350 60 275 100 200 C135 135 175 95 185 115 C170 155 140 215 110 290 C85 345 58 378 -20 400 Z"
            fill="#0A2010" opacity="0.6"/>
    </svg>
    <svg class="absolute right-0 top-0 opacity-30" viewBox="0 0 300 400" style="height: 300px; width: auto;">
      <path d="M320 0 C290 60 260 140 215 215 C180 280 135 320 125 300 C140 260 170 200 200 120 C225 60 250 25 320 0 Z"
            fill="#071A07"/>
    </svg>
  </div>
)}

{variant === 'footer' && (
  <svg viewBox="0 0 120 80" style="width: 70px; opacity: 0.12;" aria-hidden="true">
    <!-- Coatí silhouette for footer -->
    <ellipse cx="60" cy="55" rx="32" ry="20" fill="#F2EDE3"/>
    <ellipse cx="88" cy="44" rx="20" ry="14" fill="#F2EDE3"/>
    <ellipse cx="106" cy="40" rx="11" ry="7" fill="#F2EDE3"/>
    <circle cx="94" cy="40" r="3.5" fill="#0F0F0F"/>
    <!-- Tail up -->
    <path d="M28 52 C22 32 28 12 40 20 C52 28 48 46 42 54"
          stroke="#F2EDE3" stroke-width="7" fill="none" stroke-linecap="round"/>
  </svg>
)}
