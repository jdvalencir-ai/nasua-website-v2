---
import { MIEMBROS } from '../data/members';
import { asset } from '../utils/asset';
---

<section id="colectivo" class="relative py-24 md:py-36 overflow-hidden"
  style="background: linear-gradient(180deg, #060906 0%, #080D08 100%);">

  <!-- Fondo fotográfico de selva -->
  <img
    src={asset('/images/hero/darkjungle.jpg')}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover opacity-30 pointer-events-none select-none"
  />
  <!-- Oscurecido para integrar la selva con la paleta -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
       style="background: linear-gradient(180deg, rgba(6,9,6,0.82) 0%, rgba(6,9,6,0.7) 45%, rgba(6,9,6,0.92) 100%);"></div>

  <!-- Textura de manchas de jaguar — patrón de fondo -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.025]" aria-hidden="true">
    <svg width="100%" height="100%">
      <pattern id="jaguar" x="0" y="0" width="120" height="120" patternUnits="userSpaceOnUse">
        <!-- Roseta central -->
        <circle cx="60" cy="60" r="14" fill="none" stroke="#F2EDE3" stroke-width="1.5"/>
        <circle cx="60" cy="60" r="4" fill="#F2EDE3"/>
        <!-- Manchas satélite -->
        <circle cx="60" cy="38" r="4" fill="#F2EDE3"/>
        <circle cx="60" cy="82" r="4" fill="#F2EDE3"/>
        <circle cx="38" cy="60" r="4" fill="#F2EDE3"/>
        <circle cx="82" cy="60" r="4" fill="#F2EDE3"/>
        <circle cx="44" cy="44" r="3" fill="#F2EDE3"/>
        <circle cx="76" cy="44" r="3" fill="#F2EDE3"/>
        <circle cx="44" cy="76" r="3" fill="#F2EDE3"/>
        <circle cx="76" cy="76" r="3" fill="#F2EDE3"/>
      </pattern>
      <rect width="100%" height="100%" fill="url(#jaguar)"/>
    </svg>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-10 lg:px-16">

    <!-- Encabezado editorial -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-end mb-16 md:mb-20">
      <div>
        <div class="flex items-center gap-4 mb-5" data-reveal>
          <div class="h-px w-10 bg-[#E8681C]"></div>
          <span class="font-[family-name:var(--font-display)] text-[10px] tracking-[0.6em] uppercase text-[#E8681C] font-600">
            El Nombre
          </span>
        </div>
        <h2 class="font-[family-name:var(--font-display)] font-800 text-[#F2EDE3] leading-[0.88]"
            style="font-size: clamp(2.5rem, 6vw, 5rem);" data-reveal>
          ¿Por qué el<br/>nombre<br/>Nasúa?
        </h2>
      </div>
      <p class="text-[#6B7280] leading-relaxed max-w-sm text-sm self-end" data-reveal>
        Dentro de nuestra flora y fauna latinoamericana vive un animal intrépido,
        luchador y arriesgado que representa nuestra fuerza como latinos.
        <strong class="text-[#F0EBE2] font-600">Nasúa</strong> simboliza identidad,
        valentía, unidad y raíz.
      </p>
    </div>

    <!-- Grid: 1 col (móvil) · 2 cols (tablet) · 4 cols (escritorio) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
      {MIEMBROS.map((miembro, index) => {
        return (
          <article
            class="member-card group relative overflow-hidden"
            data-reveal
            style={`transition-delay: ${index * 80}ms`}
          >
            <!-- Imagen / placeholder de foto -->
            <div
              class="relative overflow-hidden"
              style="aspect-ratio: 4/5;"
            >
              <!-- Foto del miembro como fondo -->
              <img
                src={asset(miembro.imagen)}
                alt={miembro.nombre}
                class:list={["absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105", miembro.imagen.includes('nasua') && "-top-9"]}
                loading="lazy"
                style="filter: grayscale(0.08) contrast(1.02) brightness(1.08);"
              />

              <!-- Capa de tinte color para integrar con la paleta jungla -->
              <div
                class="absolute inset-0 mix-blend-multiply pointer-events-none"
                style={`background: ${
                  index === 0 ? 'linear-gradient(160deg, rgba(10,30,10,0.18), rgba(17,24,17,0.22), rgba(6,9,6,0.4))' :
                  index === 1 ? 'linear-gradient(160deg, rgba(17,16,17,0.18), rgba(26,13,13,0.22), rgba(6,9,6,0.4))' :
                                'linear-gradient(160deg, rgba(10,16,10,0.18), rgba(13,24,13,0.22), rgba(6,9,6,0.4))'
                };`}
              ></div>

              <!-- Gradiente overlay inferior -->
              <div class="absolute inset-0"
                   style="background: linear-gradient(to top, rgba(6,9,6,0.96) 0%, rgba(6,9,6,0.82) 42%, rgba(6,9,6,0.35) 62%, transparent 82%);">
              </div>

              <!-- Número de posición decorativo -->
              <span class="absolute top-4 right-4 font-[family-name:var(--font-display)] font-800 text-[#F2EDE3] opacity-[0.06]"
                    style="font-size: 3.5rem; line-height: 1;"
                    aria-hidden="true">
                0{index + 1}
              </span>

              <!-- Info del miembro sobre la imagen.
                   Anclada al 50% de la tarjeta para que la raya naranja
                   quede al mismo nivel en todas las cards. -->
              <div class="absolute inset-x-0 bottom-0 top-1/2 p-5 md:p-6 flex flex-col overflow-hidden">
                <!-- Línea roja -->
                <div class="h-0.5 bg-[#E8681C] mb-3 transition-all duration-500 origin-left shrink-0"
                     style="width: 24px;"
                     id={`member-line-${index}`}></div>

                <h3 class="font-[family-name:var(--font-display)] font-800 text-[#F2EDE3] mb-0.5 shrink-0"
                    style="font-size: 1.5rem;">
                  {miembro.nombre}
                </h3>
                <p class="font-[family-name:var(--font-display)] text-[10px] tracking-[0.4em] uppercase font-600 shrink-0"
                   style="color: #2A6B2A;">
                  {miembro.rol}
                </p>

                {miembro.bio && (
                  <p class="mt-3 text-[#9CA3AF] text-sm">
                    {miembro.bio}
                  </p>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  import { animate } from 'animejs';

  // Líneas de los miembros se expanden al entrar en viewport
  document.querySelectorAll('[id^="member-line-"]').forEach(line => {
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        animate(line, { width: ['24px', '100%'], duration: 600, ease: 'outExpo', delay: 200 });
        obs.disconnect();
      });
    }, { threshold: 0.4 });
    obs.observe(line as Element);
  });
</script>
