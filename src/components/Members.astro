---
import { MIEMBROS } from '../data/members';
---

<section id="colectivo" class="relative py-28 md:py-36 overflow-hidden"
  style="background: linear-gradient(180deg, #070A07 0%, #0D120D 50%, #070A07 100%);">

  <!-- Número de sección -->
  <span class="section-number top-8 right-4 md:right-10" aria-hidden="true">02</span>

  <!-- Línea divisoria superior -->
  <div class="section-divider mb-0" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-16 pt-16">

    <!-- Encabezado -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-16 gap-6">
      <div>
        <div class="flex items-center gap-4 mb-4" data-reveal>
          <div class="h-px w-12 bg-[#C41E3A]"></div>
          <span class="font-[family-name:var(--font-family-display)] text-xs tracking-[0.5em] uppercase text-[#C41E3A] font-600">
            El Colectivo
          </span>
        </div>
        <h2
          class="font-[family-name:var(--font-family-display)] font-800 text-[#F2EDE3] leading-none"
          style="font-size: clamp(2.4rem, 5vw, 4rem);"
          data-reveal
        >
          Tres voces.<br/>
          Un solo territorio.
        </h2>
      </div>

      <p class="text-[#6B7280] max-w-xs text-sm leading-relaxed" data-reveal>
        Juntos construyen un sonido que no respeta fronteras geográficas ni de género musical.
      </p>
    </div>

    <!-- Grid de miembros -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {MIEMBROS.map((miembro, index) => (
        <article
          class="member-card group relative overflow-hidden rounded"
          data-reveal
          style={`transition-delay: ${index * 100}ms`}
        >
          <!-- Imagen placeholder (se reemplaza con foto real) -->
          <div class="relative aspect-[3/4] overflow-hidden">
            <div
              class="absolute inset-0 flex flex-col items-center justify-center"
              style="background: linear-gradient(135deg, #0A1A0A 0%, #0D2B0D 50%, #0A1A0A 100%); border: 1px solid rgba(42,107,42,0.2);"
            >
              <!-- Logo como placeholder hasta tener foto real -->
              <img
                src="/logos/logo-icon.png"
                alt={`Foto de ${miembro.nombre} — PENDIENTE`}
                class="logo-img w-24 h-auto opacity-20 group-hover:opacity-30 transition-opacity duration-500"
                width="96"
                height="96"
              />
              <span class="mt-4 text-[10px] tracking-[0.3em] uppercase text-[#6B7280] font-[family-name:var(--font-family-display)]">
                Foto pendiente
              </span>
            </div>

            <!-- Overlay en hover -->
            <div
              class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
              style="background: linear-gradient(to top, rgba(7,10,7,0.9) 0%, transparent 60%);"
            ></div>
          </div>

          <!-- Info del miembro -->
          <div
            class="p-5"
            style="background: rgba(13,18,13,0.8); border: 1px solid rgba(42,107,42,0.15); border-top: none;"
          >
            <!-- Línea roja de acento -->
            <div class="w-8 h-0.5 bg-[#C41E3A] mb-3 transition-all duration-300 group-hover:w-full"></div>

            <h3 class="font-[family-name:var(--font-family-display)] font-800 text-[#F2EDE3] text-xl mb-1">
              {miembro.nombre}
            </h3>
            <p class="text-[11px] tracking-[0.3em] uppercase text-[#2A6B2A] font-600 font-[family-name:var(--font-family-display)] mb-3">
              {miembro.rol}
            </p>
            <p class="text-[#6B7280] text-sm leading-relaxed">
              {miembro.bio}
            </p>

            {miembro.instagram && (
              <a
                href={miembro.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex items-center gap-2 text-xs tracking-widest uppercase text-[#6B7280] hover:text-[#F2EDE3] transition-colors duration-300 font-[family-name:var(--font-family-display)] font-600"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
                Instagram
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Línea divisoria inferior -->
  <div class="section-divider mt-16" aria-hidden="true"></div>
</section>
