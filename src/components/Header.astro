---
import { asset } from '../utils/asset';

const NAV = [
  { href: '#about',    label: 'Orígenes'  },
  { href: '#musica',   label: 'Música'    },
  { href: '#videos',   label: 'Videos'    },
  { href: '#fanclub',  label: 'Fanclub'   },
  { href: '#shop',     label: 'Shop'      },
  { href: '#contacto', label: 'Contacto'  },
];
---

<!-- ══ HEADER FIJO ════════════════════════════════════════════ -->
<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-[90] h-[68px] flex items-center px-5 md:px-10 lg:px-14"
>
  <!-- Fondo glassmorphism (aparece al hacer scroll) -->
  <div
    id="header-bg"
    class="absolute inset-0 pointer-events-none opacity-0 transition-opacity duration-500"
    style="background: rgba(8,6,4,0.88); backdrop-filter: blur(20px) saturate(1.4); -webkit-backdrop-filter: blur(20px) saturate(1.4); border-bottom: 1px solid rgba(232,104,28,0.1);"
    aria-hidden="true"
  ></div>

  <!-- Logo -->
  <a href="#inicio" id="header-logo" class="relative z-10 flex items-center opacity-0"
     aria-label="Nasúa — inicio">
    <img
      src={asset('/logos/logo-horizontal-dark.png')}
      alt="Nasúa Narica"
      class="h-8 md:h-9 w-auto"
      width="220" height="48"
    />
  </a>

  <!-- Nav desktop -->
  <nav class="relative z-10 hidden md:flex items-center gap-7 lg:gap-9 ml-auto mr-2"
       aria-label="Navegación principal">
    {NAV.map(link => (
      <a
        href={link.href}
        class="nav-link relative font-[family-name:var(--font-display)] text-[11px] font-600 tracking-[0.5em] uppercase text-[#A89880] hover:text-[#F5EDE0] transition-colors duration-300 opacity-0 pb-0.5"
      >
        {link.label}
        <span class="nav-underline absolute bottom-0 left-0 h-px w-0 bg-[#E8681C] transition-none"></span>
      </a>
    ))}
  </nav>

  <!-- Botón hamburguesa (mobile) -->
  <button
    id="menu-btn"
    class="relative z-[200] md:hidden ml-auto flex flex-col items-end gap-[5px] p-2.5 -mr-1"
    aria-label="Abrir menú"
    aria-expanded="false"
  >
    <span class="burger-line w-6"></span>
    <span class="burger-line w-4"></span>
    <span class="burger-line w-6"></span>
  </button>
</header>

<!-- ══ OVERLAY FULL-SCREEN ══════════════════════════════════ -->
<!-- Está FUERA del header para evitar clipping -->
<div
  id="menu-overlay"
  class="fixed inset-0 z-[150] flex flex-col pointer-events-none"
  style="background: #0D0904;"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
>
  <!-- Grain interior del menú -->
  <div class="grain-overlay absolute inset-0" aria-hidden="true"></div>

  <!-- Decoración jungle en el overlay -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <!-- Hoja izquierda -->
    <svg class="absolute -left-16 bottom-0 opacity-[0.07]"
         style="animation: float-leaf 10s ease-in-out infinite;"
         width="300" height="480" viewBox="0 0 80 130" fill="#2A6B1A">
      <path d="M40 125 C40 125 20 80 15 50 C10 20 30 2 40 2 C50 2 70 20 65 50 C60 80 40 125 40 125Z"/>
    </svg>
    <!-- Hoja derecha -->
    <svg class="absolute -right-10 top-12 opacity-[0.05]"
         style="transform: rotate(155deg); animation: float-leaf 13s ease-in-out infinite 2s;"
         width="200" height="320" viewBox="0 0 80 130" fill="#1A4A10">
      <path d="M40 125 C40 125 20 80 15 50 C10 20 30 2 40 2 C50 2 70 20 65 50 C60 80 40 125 40 125Z"/>
    </svg>
    <!-- "NASUA" ghost en el fondo -->
    <span
      class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 font-[family-name:var(--font-display)] font-800 text-transparent select-none pointer-events-none whitespace-nowrap"
      style="font-size: clamp(6rem, 22vw, 18rem); letter-spacing: -0.02em; -webkit-text-stroke: 1px rgba(232,104,28,0.05);"
      aria-hidden="true"
    >NASUA</span>
  </div>

  <!-- Contenido del menú -->
  <div class="relative z-10 flex flex-col h-full px-8 md:px-14 py-8">

    <!-- Fila superior: logo + cerrar -->
    <div class="flex items-center justify-between mb-auto">
      <img
        src={asset('/logos/logo-icon-dark.png')}
        alt="Nasúa"
        class="h-10 w-auto opacity-60"
        width="40" height="40"
        aria-hidden="true"
      />
    </div>

    <!-- Links de navegación -->
    <nav class="flex flex-col gap-1 mt-auto mb-10" aria-label="Menú principal">
      {NAV.map((link, i) => (
        <a
          href={link.href}
          class="overlay-link group flex items-center gap-5 py-2 opacity-0"
          data-index={i}
          style={`transform: translateX(-40px);`}
          data-overlay-link
        >
          <!-- Número pequeño -->
          <span class="font-[family-name:var(--font-display)] text-xs tracking-widest text-[#5C5248] font-600 w-6 shrink-0">
            0{i + 1}
          </span>
          <!-- Nombre -->
          <span
            class="font-[family-name:var(--font-display)] font-800 text-[#F5EDE0] leading-none group-hover:text-[#E8681C] transition-colors duration-200"
            style="font-size: clamp(2.2rem, 7vw, 4.5rem); letter-spacing: -0.02em;"
          >
            {link.label}
          </span>
          <!-- Flecha que aparece en hover -->
          <svg class="ml-auto opacity-0 group-hover:opacity-100 transition-opacity duration-200 shrink-0"
               width="24" height="24" viewBox="0 0 24 24" fill="none"
               stroke="#E8681C" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      ))}
    </nav>

    <!-- Redes sociales -->
    <div class="overlay-socials flex items-center gap-6 pt-6 border-t border-[rgba(245,237,224,0.08)] opacity-0">
      <a href="https://instagram.com/nasuamusica" target="_blank" rel="noopener"
         class="font-[family-name:var(--font-display)] text-[10px] tracking-[0.5em] uppercase text-[#5C5248] hover:text-[#E8681C] transition-colors duration-300 font-600">
        Instagram
      </a>
      <div class="h-3 w-px bg-[rgba(245,237,224,0.15)]" aria-hidden="true"></div>
      <a href="https://youtube.com/@nasuamusica" target="_blank" rel="noopener"
         class="font-[family-name:var(--font-display)] text-[10px] tracking-[0.5em] uppercase text-[#5C5248] hover:text-[#E8681C] transition-colors duration-300 font-600">
        YouTube
      </a>
    </div>
  </div>
</div>

<script>
  import { animate, createTimeline } from 'animejs';

  const header    = document.getElementById('site-header')!;
  const headerBg  = document.getElementById('header-bg')!;
  const logo      = document.getElementById('header-logo')!;
  const menuBtn   = document.getElementById('menu-btn')!;
  const overlay   = document.getElementById('menu-overlay')!;
  const navLinks  = document.querySelectorAll<HTMLElement>('.overlay-link');
  const socials   = document.querySelector<HTMLElement>('.overlay-socials')!;

  // ── Entrada inicial del header ─────────────────────────────
  animate(logo, {
    opacity: [0, 1], translateY: [-10, 0],
    duration: 600, delay: 500, ease: 'outExpo',
  });
  animate('.nav-link', {
    opacity: [0, 1], translateY: [-8, 0],
    delay: (el: Element, i: number) => 600 + i * 60,
    duration: 400, ease: 'outQuart',
  });

  // ── Glassmorphism al hacer scroll ──────────────────────────
  window.addEventListener('scroll', () => {
    headerBg.style.opacity = window.scrollY > 60 ? '1' : '0';
  }, { passive: true });

  // ── Subrayado animado en nav desktop ──────────────────────
  document.querySelectorAll<HTMLElement>('.nav-link').forEach(link => {
    const line = link.querySelector<HTMLElement>('.nav-underline')!;
    link.addEventListener('mouseenter', () => {
      line.style.transition = 'width 0.22s cubic-bezier(0.4,0,0.2,1)';
      line.style.width = '100%';
    });
    link.addEventListener('mouseleave', () => {
      line.style.transition = 'width 0.18s cubic-bezier(0.4,0,0.2,1)';
      line.style.width = '0%';
    });
  });

  // ── Hamburguesa / Overlay ──────────────────────────────────
  let isOpen = false;

  function openMenu() {
    isOpen = true;
    menuBtn.classList.add('is-open');
    menuBtn.setAttribute('aria-expanded', 'true');
    overlay.classList.add('is-open');
    overlay.style.pointerEvents = 'auto';
    overlay.setAttribute('aria-hidden', 'false');
    document.body.classList.add('menu-open');

    // Stagger de links (esperar a que el clip-path termine ~500ms)
    animate(navLinks, {
      opacity:    [0, 1],
      translateX: [-40, 0],
      delay:      (el: Element, i: number) => 320 + i * 65,
      duration:   500,
      ease:       'outExpo',
    });
    animate(socials, {
      opacity: [0, 1], translateY: [12, 0],
      delay: 320 + navLinks.length * 65,
      duration: 400, ease: 'outQuart',
    });
  }

  function closeMenu() {
    isOpen = false;
    menuBtn.classList.remove('is-open');
    menuBtn.setAttribute('aria-expanded', 'false');

    // Resetear links para la próxima apertura
    navLinks.forEach(l => {
      l.style.opacity = '0';
      l.style.transform = 'translateX(-40px)';
    });
    if (socials) socials.style.opacity = '0';

    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('menu-open');

    // Deshabilitar pointer-events al acabar la transición
    overlay.addEventListener('transitionend', () => {
      if (!isOpen) overlay.style.pointerEvents = 'none';
    }, { once: true });
  }

  menuBtn.addEventListener('click', () => isOpen ? closeMenu() : openMenu());

  // Cerrar al hacer click en un link del overlay
  document.querySelectorAll('[data-overlay-link]').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Cerrar con Escape
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && isOpen) closeMenu();
  });
</script>
