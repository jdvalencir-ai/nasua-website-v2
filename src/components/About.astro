---
import { asset } from '../utils/asset';
---

<section id="about" class="relative overflow-hidden"
  style="background: #060906; padding: 8rem 0 6rem;">

  <!-- Hoja decorativa en fondo -->
  <div class="absolute -right-24 top-0 opacity-[0.04] pointer-events-none" aria-hidden="true"
       style="transform: rotate(20deg);">
    <svg width="500" height="800" viewBox="0 0 80 130" fill="#2A6B2A">
      <path d="M40 125 C40 125 20 80 15 50 C10 20 30 2 40 2 C50 2 70 20 65 50 C60 80 40 125 40 125Z"/>
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-16">

    <!-- Etiqueta de sección -->
    <div class="flex items-center gap-4 mb-16 md:mb-20" data-reveal>
      <div class="h-px w-10 bg-[#C41E3A]"></div>
      <span class="font-[family-name:var(--font-family-display)] text-[10px] tracking-[0.6em] uppercase text-[#C41E3A] font-600">
        Orígenes
      </span>
    </div>

    <!-- Cita enorme — primer impacto visual -->
    <div class="mb-20 md:mb-28" data-reveal>
      <p class="font-[family-name:var(--font-family-display)] font-800 text-[#F2EDE3] leading-[0.9]"
         style="font-size: clamp(2.8rem, 7vw, 7rem);">
        No somos<br/>
        un género.<br/>
        <span style="color: #C41E3A;">Somos</span> un<br/>
        territorio.
      </p>
    </div>

    <!-- Layout de dos columnas: bio + imagen -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">

      <!-- Columna de texto -->
      <div class="lg:col-span-7 lg:col-start-1">

        <div class="space-y-6 mb-12">
          <p class="text-[#9CA3AF] leading-[1.8] text-lg md:text-xl" data-reveal>
            <strong class="text-[#F2EDE3] font-600">Nasúa</strong> es un colectivo musical
            latinoamericano que lleva el nombre del coatí — ese animal curioso, ágil e
            indomable. Como él, su música no se deja clasificar.
          </p>

          <p class="text-[#6B7280] leading-[1.8]" data-reveal>
            Pop tropical que dialoga con el funk, el afrobeat y la electrónica sin pedir permiso.
            Tres voces que construyen algo mayor que la suma de sus partes.
          </p>

          <p class="text-[#6B7280] leading-[1.8]" data-reveal>
            Su propuesta — <em class="text-[#F2EDE3] not-italic">Música Sin Fronteras</em> —
            es un manifiesto. La música latinoamericana no cabe en una sola categoría,
            en un solo idioma ni en un solo continente.
          </p>
        </div>

        <!-- Línea divisoria minimalista -->
        <div class="h-px w-full mb-8" style="background: rgba(255,255,255,0.06);" aria-hidden="true"></div>

        <!-- Datos minimalistas — sin cajas, solo texto -->
        <div class="grid grid-cols-2 gap-y-5 gap-x-8" data-reveal>
          {[
            { label: 'Origen',   valor: 'América Latina'        },
            { label: 'Género',   valor: 'Pop Tropical / Fusión'  },
            { label: 'Formados', valor: '2022'                   },
            { label: 'Idioma',   valor: 'Español · Global'       },
          ].map(d => (
            <div>
              <dt class="font-[family-name:var(--font-family-display)] text-[9px] tracking-[0.5em] uppercase text-[#C41E3A] font-600 mb-0.5">
                {d.label}
              </dt>
              <dd class="font-[family-name:var(--font-family-display)] text-[#F2EDE3] font-600 text-sm tracking-wide">
                {d.valor}
              </dd>
            </div>
          ))}
        </div>
      </div>

      <!-- Columna visual: ícono grande con atmósfera -->
      <div class="lg:col-span-4 lg:col-start-9 flex flex-col items-center lg:items-end" data-reveal-right>

        <!-- Marco editorial para la imagen del artista -->
        <div class="relative w-full max-w-xs">
          <!-- Borde editorial -->
          <div class="absolute -top-3 -left-3 w-16 h-16 border-l-2 border-t-2 border-[#C41E3A] opacity-60"></div>
          <div class="absolute -bottom-3 -right-3 w-16 h-16 border-r-2 border-b-2 border-[#C41E3A] opacity-60"></div>

          <!-- Placeholder de foto de banda -->
          <div class="relative aspect-[3/4] w-full overflow-hidden"
               style="background: linear-gradient(160deg, #0A1E0A 0%, #0D2B0D 60%, #060906 100%);">
            <!-- Logo como elemento visual hasta tener foto real -->
            <img
              src={asset('/logos/logo-icon.png')}
              alt="Nasúa Narica"
              class="logo-img absolute inset-0 m-auto w-2/3 h-auto opacity-[0.12]"
              width="200" height="200"
            />
            <!-- Texto de contexto discreto -->
            <div class="absolute bottom-0 left-0 right-0 p-4"
                 style="background: linear-gradient(to top, rgba(6,9,6,0.9), transparent);">
              <p class="font-[family-name:var(--font-family-display)] text-[9px] tracking-[0.4em] uppercase text-[#6B7280]">
                Foto del colectivo
              </p>
            </div>
          </div>
        </div>

        <!-- Año en tipografía enorme — elemento decorativo -->
        <p class="mt-6 font-[family-name:var(--font-family-display)] font-800 text-[#F2EDE3] opacity-[0.04]"
           style="font-size: 7rem; line-height: 1; letter-spacing: -0.04em;">
          2022
        </p>
      </div>
    </div>
  </div>
</section>
