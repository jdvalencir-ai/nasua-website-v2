---
import { asset } from '../utils/asset';
import JungleScene from './JungleScene.astro';
---

<section id="about" class="relative overflow-hidden"
  style="background: linear-gradient(180deg, #040804 0%, #060C06 40%, #050A05 100%); padding: 8rem 0 7rem;">

  <!-- Jungle section corner accents -->
  <JungleScene variant="section" />

  <!-- Atmospheric glow from top-left (as if light coming through leaves) -->
  <div class="absolute top-0 left-0 w-2/3 h-1/2 pointer-events-none" aria-hidden="true"
       style="background: radial-gradient(ellipse at 0% 0%, rgba(120,65,8,0.06) 0%, transparent 65%);">
  </div>

  <!-- Large watermark number -->
  <span class="absolute right-6 top-8 font-[family-name:var(--font-display)] font-800 pointer-events-none select-none"
        style="font-size: clamp(7rem, 18vw, 16rem); line-height: 1; color: rgba(255,255,255,0.018); letter-spacing: -0.04em;"
        aria-hidden="true">01</span>

  <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-16 relative z-10">

    <!-- Section label -->
    <div class="flex items-center gap-4 mb-16 md:mb-20" data-reveal>
      <div class="h-px w-10 bg-[#E8681C]"></div>
      <span class="font-[family-name:var(--font-display)] text-[10px] tracking-[0.6em] uppercase text-[#E8681C] font-600">
        Orígenes
      </span>
    </div>

    <!-- Giant pull quote — first visual punch -->
    <div class="mb-20 md:mb-28" data-reveal>
      <p class="font-[family-name:var(--font-display)] font-800 text-[#F0EBE2] leading-[0.88]"
         style="font-size: clamp(2.8rem, 7vw, 7rem); letter-spacing: 0.01em;">
        No somos<br/>
        un género.<br/>
        <span style="color: #E8681C;">Somos</span> un<br/>
        territorio.
      </p>
    </div>

    <!-- Two-column: text left, visual right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">

      <!-- Text column -->
      <div class="lg:col-span-7 lg:col-start-1">

        <div class="space-y-6 mb-12">
          <p class="text-[#9CA3AF] leading-[1.85] text-lg md:text-xl" data-reveal>
            <strong class="text-[#F0EBE2] font-600">Nasúa</strong> es un colectivo musical
            latinoamericano que lleva el nombre del coatí — ese animal curioso, ágil e
            indomable. Como él, su música no se deja clasificar.
          </p>

          <p class="text-[#6B7280] leading-[1.85]" data-reveal>
            Pop tropical que dialoga con el funk, el afrobeat y la electrónica sin pedir permiso.
            Tres voces que construyen algo mayor que la suma de sus partes.
          </p>

          <p class="text-[#6B7280] leading-[1.85]" data-reveal>
            Su propuesta — <em class="text-[#F0EBE2] not-italic">Música Sin Fronteras</em> —
            es un manifiesto. La música latinoamericana no cabe en una sola categoría,
            en un solo idioma ni en un solo continente.
          </p>
        </div>

        <!-- Thin divider -->
        <div class="h-px w-full mb-8" style="background: rgba(255,255,255,0.05);" aria-hidden="true"></div>

        <!-- Band facts — minimal, no boxes -->
        <div class="grid grid-cols-2 gap-y-5 gap-x-8" data-reveal>
          {[
            { label: 'Origen',   valor: 'América Latina'        },
            { label: 'Género',   valor: 'Pop Tropical / Fusión'  },
            { label: 'Formados', valor: '2022'                   },
            { label: 'Idioma',   valor: 'Español · Global'       },
          ].map(d => (
            <div>
              <dt class="font-[family-name:var(--font-display)] text-[9px] tracking-[0.5em] uppercase text-[#E8681C] font-600 mb-0.5">
                {d.label}
              </dt>
              <dd class="font-[family-name:var(--font-display)] text-[#F0EBE2] font-600 text-sm tracking-wide">
                {d.valor}
              </dd>
            </div>
          ))}
        </div>
      </div>

      <!-- Visual column: editorial photo placeholder -->
      <div class="lg:col-span-4 lg:col-start-9 flex flex-col items-center lg:items-end" data-reveal-right>

        <div class="relative w-full max-w-xs">
          <!-- Orange corner brackets -->
          <div class="absolute -top-3 -left-3 w-14 h-14 border-l-2 border-t-2 border-[#E8681C] opacity-50"></div>
          <div class="absolute -bottom-3 -right-3 w-14 h-14 border-r-2 border-b-2 border-[#E8681C] opacity-50"></div>

          <!-- Foto real del colectivo (desde el sitio oficial) -->
          <div class="relative aspect-[3/2] w-full overflow-hidden" style="background:#07120a;">
            <img
              src={asset('/images/about/colectivo.jpg')}
              alt="Nasúa Narica — el colectivo"
              class="w-full h-full object-cover"
              style="object-position: center;"
              width="1800" height="1200"
              loading="lazy"
            />
            <!-- Tinte de marca + gradiente inferior -->
            <div class="absolute inset-0 pointer-events-none mix-blend-multiply"
                 style="background: rgba(8,20,8,0.12);"></div>
            <div class="absolute inset-0 pointer-events-none"
                 style="background: linear-gradient(to top, rgba(5,13,5,0.7) 0%, transparent 55%);"></div>
            <!-- Label -->
            <div class="absolute bottom-0 left-0 right-0 p-3">
              <p class="font-[family-name:var(--font-display)] text-[9px] tracking-[0.4em] uppercase text-[#C9C2B4]">
                El colectivo
              </p>
            </div>
          </div>
        </div>

        <!-- Decorative year -->
        <p class="mt-6 font-[family-name:var(--font-display)] font-800 text-[#F2EDE3] opacity-[0.03]"
           style="font-size: 7rem; line-height: 1; letter-spacing: -0.04em;">
          2022
        </p>
      </div>
    </div>
  </div>
</section>
