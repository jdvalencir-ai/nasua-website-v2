---
import { asset } from '../utils/asset';
---

<section id="about" class="relative py-28 md:py-40 overflow-hidden">

  <!-- Número de sección decorativo -->
  <span class="section-number top-8 left-4 md:left-10 select-none" aria-hidden="true">01</span>

  <!-- Hoja decorativa -->
  <div class="absolute -right-16 top-20 opacity-[0.06] rotate-[30deg] hidden lg:block" aria-hidden="true">
    <svg width="200" height="320" viewBox="0 0 80 130" fill="#2A6B2A">
      <path d="M40 125 C40 125 20 80 15 50 C10 20 30 2 40 2 C50 2 70 20 65 50 C60 80 40 125 40 125Z"/>
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-16">

    <!-- Etiqueta de sección -->
    <div class="flex items-center gap-4 mb-12" data-reveal>
      <div class="h-px w-12 bg-[#C41E3A]"></div>
      <span class="font-[family-name:var(--font-family-display)] text-xs tracking-[0.5em] uppercase text-[#C41E3A] font-600">
        Orígenes
      </span>
    </div>

    <!-- Layout de dos columnas -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start">

      <!-- Columna izquierda: texto principal -->
      <div>
        <h2
          class="font-[family-name:var(--font-family-display)] font-800 text-[#F2EDE3] leading-none mb-8"
          style="font-size: clamp(2.8rem, 6vw, 5rem);"
          data-reveal
        >
          Donde la selva<br/>
          <span style="color: #C41E3A;">rompe</span> el silencio.
        </h2>

        <!-- Bio principal (press kit) -->
        <div class="space-y-5 data-reveal-block">
          <p
            class="text-[#9CA3AF] leading-relaxed text-lg"
            data-reveal
          >
            <strong class="text-[#F2EDE3] font-600">Nasúa</strong> es un colectivo musical latinoamericano
            que nació en la intersección entre la selva y el futuro. Tomando el nombre del coatí
            —ese animal curioso, ágil e indomable—, la banda construyó un universo sonoro donde el
            pop tropical dialoga con el funk, el afrobeat y la electrónica sin pedir permiso.
          </p>

          <p class="text-[#9CA3AF] leading-relaxed" data-reveal>
            Su propuesta, bautizada <em class="text-[#F2EDE3] not-italic font-500">Música Sin Fronteras</em>,
            es más que un género: es un manifiesto. Una declaración de que la música latinoamericana no
            cabe en una sola categoría, en un solo idioma ni en un solo continente.
          </p>

          <p class="text-[#9CA3AF] leading-relaxed" data-reveal>
            Con cada lanzamiento, Nasúa ha demostrado que la identidad colectiva puede ser poderosa sin
            perder individualidad. Sus tres voces —tan distintas como complementarias— construyen algo
            mayor que la suma de sus partes.
          </p>
        </div>

        <!-- Cita destacada -->
        <blockquote
          class="mt-10 pl-5 border-l-2 border-[#C41E3A]"
          data-reveal
        >
          <p class="font-[family-name:var(--font-family-display)] font-700 text-[#F2EDE3] text-xl leading-snug italic">
            "No somos un género.<br/>Somos un territorio."
          </p>
          <cite class="mt-2 block text-sm text-[#6B7280] not-italic tracking-widest uppercase font-[family-name:var(--font-family-display)]">
            — Nasúa Narica
          </cite>
        </blockquote>

        <!-- Botón descarga EPK -->
        <div class="mt-10" data-reveal>
          <a
            href="#contacto"
            class="btn-outline"
          >
            <span>Solicitar Press Kit completo</span>
          </a>
        </div>
      </div>

      <!-- Columna derecha: stats + logo -->
      <div class="lg:pt-8">

        <!-- Logo grande del ícono -->
        <div class="relative mb-12 flex justify-center lg:justify-start" data-reveal-scale>
          <div class="relative inline-block">
            <!-- Glow rojo detrás del logo -->
            <div
              class="absolute inset-0 rounded-full blur-3xl opacity-20"
              style="background: radial-gradient(circle, #C41E3A 0%, transparent 70%); transform: scale(1.2);"
              aria-hidden="true"
            ></div>
            <div
              class="absolute inset-0 rounded-full blur-2xl opacity-10"
              style="background: radial-gradient(circle, #2A6B2A 0%, transparent 70%); transform: scale(1.5);"
              aria-hidden="true"
            ></div>
            <img
              src={asset('/logos/logo-icon.png')}
              alt="Ícono Nasúa"
              class="logo-img relative z-10 w-48 md:w-56 h-auto"
              width="224"
              height="224"
              id="about-icon"
            />
          </div>
        </div>

        <!-- Stats del press kit -->
        <div class="grid grid-cols-2 gap-4 mb-10" data-reveal>
          {[
            { label: 'Género',   value: 'Pop Tropical / Fusión' },
            { label: 'Origen',   value: 'América Latina'        },
            { label: 'Idioma',   value: 'Español / Multilingüe' },
            { label: 'Formados', value: '2022'                  },
          ].map(stat => (
            <div
              class="p-4 rounded"
              style="background: rgba(15,43,15,0.3); border: 1px solid rgba(42,107,42,0.2);"
            >
              <dt class="text-[10px] tracking-[0.4em] uppercase text-[#6B7280] font-[family-name:var(--font-family-display)] font-600 mb-1">
                {stat.label}
              </dt>
              <dd class="text-[#F2EDE3] font-600 text-sm">{stat.value}</dd>
            </div>
          ))}
        </div>

        <!-- Géneros / tags -->
        <div class="flex flex-wrap gap-2" data-reveal>
          {['Pop Tropical', 'Fusión', 'Afrobeat', 'Electrónica', 'Música Sin Fronteras', 'Indie Latino'].map(tag => (
            <span
              class="text-[11px] tracking-wider uppercase font-[family-name:var(--font-family-display)] font-600 px-3 py-1.5 rounded-full"
              style="background: rgba(42,107,42,0.15); border: 1px solid rgba(42,107,42,0.3); color: #6B7280;"
            >
              {tag}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from 'animejs';

  // Animación del ícono al hacer hover (respiración)
  const icon = document.getElementById('about-icon');
  if (icon) {
    animate(icon, {
      scale:    [1, 1.04],
      duration: 3500,
      loop:     true,
      alternate: true,
      ease:     'inOutSine',
    });
  }
</script>
