---
import { REDES } from '../data/config';
import { asset } from '../utils/asset';

const year = new Date().getFullYear();
---

<footer
  class="relative py-12 px-6 md:px-10 lg:px-16 overflow-hidden"
  style="background: #040604; border-top: 1px solid rgba(42,107,42,0.15);"
>
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row items-center md:items-start justify-between gap-8">

      <!-- Logo -->
      <div class="flex flex-col items-center md:items-start">
        <a href="#inicio" class="mb-4" aria-label="Nasúa Narica — volver al inicio">
          <img
            src={asset('/logos/logo-wordmark.png')}
            alt="Nasúa Narica"
            class="logo-inv h-8 w-auto"
            width="160"
            height="32"
          />
        </a>
        <p class="text-[10px] tracking-[0.3em] uppercase text-[#6B7280] font-[family-name:var(--font-display)] font-600">
          Música Sin Fronteras
        </p>
      </div>

      <!-- Nav footer -->
      <nav class="flex flex-wrap justify-center md:justify-start gap-6" aria-label="Navegación del pie">
        {[
          { href: '#about',    label: 'Orígenes' },
          { href: '#musica',   label: 'Música'   },
          { href: '#videos',   label: 'Videos'   },
          { href: '#fanclub',  label: 'Fanclub'  },
          { href: '#shop',     label: 'Shop'     },
          { href: '#contacto', label: 'Contacto' },
        ].map(link => (
          <a
            href={link.href}
            class="text-[11px] tracking-widest uppercase text-[#6B7280] hover:text-[#F2EDE3] transition-colors duration-300 font-[family-name:var(--font-display)] font-600"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Redes -->
      <div class="flex items-center gap-4">
        {REDES.instagram && (
          <a
            href={REDES.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#6B7280] hover:text-[#F2EDE3] transition-colors duration-300"
            aria-label="Instagram"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        )}
        {REDES.youtube && (
          <a
            href={REDES.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#6B7280] hover:text-[#F2EDE3] transition-colors duration-300"
            aria-label="YouTube"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        )}
      </div>
    </div>

    <!-- Línea divisoria -->
    <div class="section-divider my-8" aria-hidden="true"></div>

    <!-- Copyright -->
    <div class="flex flex-col md:flex-row items-center md:justify-between gap-3 text-center">
      <p class="text-[10px] tracking-wider uppercase text-[#6B7280] font-[family-name:var(--font-display)]">
        © {year} Nasúa Narica. Todos los derechos reservados.
      </p>
      <p class="text-[10px] tracking-wider uppercase text-[#6B7280] font-[family-name:var(--font-display)]">
        Hecho con ♥ en América Latina
      </p>
    </div>
  </div>
</footer>
