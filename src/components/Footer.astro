---
import type { Fragment } from 'astro/compiler-runtime';
import { SOCIALS } from '../data/socials';
import { MANAGER } from '../data/config';
import { asset } from '../utils/asset';

const year = new Date().getFullYear();
---

<footer
  class="relative py-12 px-6 md:px-10 lg:px-16 overflow-hidden"
  style="background: #040604; border-top: 1px solid rgba(42,107,42,0.15);"
>
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row items-center md:items-start justify-between gap-8">

      <!-- Logo -->
      <div class="flex flex-col items-center md:items-start">
        <a href="#inicio" class="mb-4" aria-label="Nasúa — volver al inicio">
          <img
            src={asset('/logos/logo-wordmark-dark.png')}
            alt="Nasúa"
            class="h-8 w-auto"
            width="160"
            height="32"
          />
        </a>
        <p class="text-[10px] tracking-[0.3em] uppercase text-[#6B7280] font-[family-name:var(--font-display)] font-600">
          Música Sin Fronteras
        </p>
      </div>

      <!-- Nav footer -->
      <nav class="flex flex-wrap justify-center md:justify-start gap-6" aria-label="Navegación del pie">
        {[
          { href: '#about',    label: 'Orígenes' },
          { href: '#musica',   label: 'Música'   },
          { href: '#videos',   label: 'Videos'   },
          { href: '#fanclub',  label: 'Fanclub'  },
          { href: '#shop',     label: 'Shop'     },
          { href: '#contacto', label: 'Contacto' },
        ].map(link => (
          <a
            href={link.href}
            class="text-[11px] tracking-widest uppercase text-[#6B7280] hover:text-[#F2EDE3] transition-colors duration-300 font-[family-name:var(--font-display)] font-600"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Redes -->
      <div class="flex items-center flex-wrap justify-center gap-4">
        {SOCIALS.map(s => (
          <a
            href={s.href || '#'}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#6B7280] hover:text-[#F2EDE3] transition-colors duration-300"
            aria-label={s.label}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={s.path}/>
            </svg>
          </a>
        ))}
      </div>
    </div>

    <!-- Línea divisoria -->
    <div class="section-divider my-8" aria-hidden="true"></div>

    <!-- Management / Booking -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 text-center sm:text-left">
        <div>
          <p class="text-[9px] tracking-[0.4em] uppercase text-[#E8681C] font-[family-name:var(--font-display)] font-600 mb-1">
            Management
          </p>
          <p class="text-sm text-[#F2EDE3] font-[family-name:var(--font-display)] font-600">
            {MANAGER.empresa} · {MANAGER.nombre}
          </p>
          <p class="text-[11px] tracking-wider uppercase text-[#6B7280] font-[family-name:var(--font-display)]">
            {MANAGER.ubicacion}
          </p>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-6">
        <a href={`tel:${MANAGER.telefono.replace(/\s/g, '')}`}
           class="text-sm text-[#9CA3AF] hover:text-[#E8681C] transition-colors duration-300 font-[family-name:var(--font-display)]">
          {MANAGER.telefono}
        </a>
        <a href={`mailto:${MANAGER.email}`}
           class="text-sm text-[#9CA3AF] hover:text-[#E8681C] transition-colors duration-300 font-[family-name:var(--font-display)]">
          {MANAGER.email}
        </a>
      </div>
    </div>

    <!-- Copyright -->
    <div class="flex flex-col md:flex-row items-center md:justify-between gap-3 text-center">
      <p class="text-[10px] tracking-wider uppercase text-[#6B7280] font-[family-name:var(--font-display)]">
        © {year} Nasúa. Todos los derechos reservados.
      </p>
      <p class="text-[10px] tracking-wider uppercase text-[#6B7280] font-[family-name:var(--font-display)]">
        Hecho con ♥ en América Latina
      </p>
    </div>
  </div>
</footer>
