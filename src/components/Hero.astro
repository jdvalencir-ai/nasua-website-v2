---
import { asset } from '../utils/asset';
import JungleScene from './JungleScene.astro';
---

<section id="inicio" class="relative min-h-screen flex flex-col justify-center overflow-hidden"
  style="background: #060906;">

  <!-- Grano de película sobre todo -->
  <div class="grain-overlay absolute inset-0 z-20 pointer-events-none" aria-hidden="true"></div>

  <!-- Gradiente radial del centro -->
  <div class="absolute inset-0"
    style="background: radial-gradient(ellipse 80% 70% at 50% 40%, rgba(12,28,12,0.7) 0%, #060906 72%);"
    aria-hidden="true">
  </div>

  <!-- Líneas de scan muy sutiles -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.018]"
    style="background-image: repeating-linear-gradient(0deg, #fff 0px, #fff 1px, transparent 1px, transparent 4px);"
    aria-hidden="true">
  </div>

  <!-- Logo pequeño — esquina superior izquierda (se oculta con el header) -->

  <!-- Contenido central -->
  <div class="relative z-10 flex flex-col items-start justify-center px-6 md:px-10 lg:px-16 pt-20 pb-40">

    <!-- Etiqueta vertical discreta -->
    <div class="flex items-center gap-3 mb-10 md:mb-14" data-reveal>
      <div class="h-px w-10 bg-[#C41E3A] opacity-70"></div>
      <span class="font-[family-name:var(--font-family-display)] text-[10px] tracking-[0.6em] uppercase text-[#C41E3A] opacity-80">
        Colectivo · América Latina
      </span>
    </div>

    <!-- "NASUA" — tipografía que llena la pantalla -->
    <div class="hero-wordmark-wrap w-full overflow-hidden" aria-label="Nasua">
      <div
        id="hero-title"
        class="hero-wordmark font-[family-name:var(--font-family-display)] font-800 text-[#F2EDE3] leading-none select-none"
        style="font-size: clamp(5rem, 21.5vw, 22rem); letter-spacing: -0.02em; line-height: 0.88;"
        aria-hidden="true"
      >
        <!-- Cada letra en su propio span para animar individualmente -->
        <span class="hero-char inline-block" data-char="N">N</span><!--
        --><span class="hero-char inline-block" data-char="A">A</span><!--
        --><span class="hero-char inline-block" data-char="S">S</span><!--
        --><span class="hero-char inline-block" data-char="U">U</span><!--
        --><span class="hero-char inline-block" data-char="A" style="color: #C41E3A;">A</span>
      </div>
    </div>

    <!-- Subtítulo editorial debajo del wordmark -->
    <div id="hero-sub" class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8 mt-6 md:mt-8 opacity-0">
      <p class="font-[family-name:var(--font-family-display)] text-[11px] md:text-xs tracking-[0.55em] uppercase text-[#6B7280] font-500 max-w-xs">
        Música Sin Fronteras<br/>Pop Tropical · Fusión
      </p>
      <div class="h-px w-full sm:w-24 bg-[#6B7280] opacity-30 sm:self-center" aria-hidden="true"></div>
      <a href="#contacto"
         class="font-[family-name:var(--font-family-display)] text-[11px] tracking-[0.4em] uppercase text-[#F2EDE3] font-600 hover:text-[#C41E3A] transition-colors duration-300">
        Booking →
      </a>
    </div>
  </div>

  <!-- Escena selvática en el fondo inferior -->
  <JungleScene variant="hero" />

  <!-- Indicador de scroll -->
  <div id="scroll-indicator"
       class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 z-30 opacity-0">
    <div id="scroll-line" class="w-px h-14 bg-gradient-to-b from-[#C41E3A] to-transparent"></div>
  </div>
</section>

<script>
  import { animate, createTimeline, spring } from 'animejs';

  // ── Secuencia de entrada ──────────────────────────────────
  const tl = createTimeline();

  // Letras: entran una por una cayendo desde arriba con distinto ángulo
  tl.add('.hero-char', {
    opacity:    [0, 1],
    translateY: (el: Element, i: number) => [-(60 + i * 20), 0],
    rotate:     (el: Element, i: number) => [i % 2 === 0 ? -6 : 6, 0],
    delay:      (el: Element, i: number) => i * 100 + 200,
    duration:   700,
    ease:       spring({ stiffness: 120, damping: 14 }),
  });

  // Subtítulo
  tl.add('#hero-sub', {
    opacity:    [0, 1],
    translateY: [16, 0],
    duration:   500,
    ease:       'outQuart',
  }, '-=200');

  // Scroll indicator
  tl.add('#scroll-indicator', {
    opacity: [0, 1],
    duration: 600,
    ease: 'outQuart',
  }, '+=400');

  // Scroll indicator pulse
  animate('#scroll-line', {
    scaleY:          [1, 0.2],
    transformOrigin: 'top center',
    duration:        1100,
    loop:            true,
    alternate:       true,
    ease:            'inOutSine',
    delay:           2000,
  });

  // ── Parallax del título al hacer scroll ──────────────────
  const wordmark = document.querySelector('.hero-wordmark-wrap') as HTMLElement;
  window.addEventListener('scroll', () => {
    if (!wordmark) return;
    wordmark.style.transform = `translateY(${window.scrollY * 0.18}px)`;
  }, { passive: true });

  // ── Efecto glitch en hover sobre las letras ───────────────
  document.querySelectorAll('.hero-char').forEach(char => {
    char.addEventListener('mouseenter', () => {
      animate(char, {
        translateX: [0, -4, 4, -2, 0],
        skewX:      [0, -3, 3, 0],
        duration:   300,
        ease:       'outElastic(1, 0.5)',
      });
    });
  });
</script>
