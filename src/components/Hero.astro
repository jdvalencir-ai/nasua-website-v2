---
import { asset } from '../utils/asset';
---

<section id="inicio" class="relative min-h-screen flex flex-col overflow-hidden"
  style="background: #03060a;">

  <!-- ── Foto real de selva (fondo) ── -->
  <img
    src={asset('/images/hero/jungle.jpg')}
    alt=""
    aria-hidden="true"
    class="hero-photo absolute inset-0 w-full h-full object-cover"
    style="object-position: center 42%; transform: scale(1.05); will-change: transform;"
    fetchpriority="high"
  />

  <!-- ── Gradación profesional ──
       oscurece + prioriza el lado del texto + viñeta + base oscura -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
    style="background:
      linear-gradient(90deg, rgba(3,6,10,0.88) 0%, rgba(3,6,10,0.5) 45%, rgba(3,6,10,0.22) 100%),
      radial-gradient(ellipse 80% 80% at 48% 42%, transparent 52%, rgba(3,6,10,0.62) 100%),
      linear-gradient(180deg, rgba(3,6,10,0.45) 0%, transparent 28%, transparent 58%, rgba(3,6,10,0.8) 100%);">
  </div>

  <!-- Tinte verde sutil — unifica con la paleta de marca -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
    style="background: rgba(8,24,10,0.22); mix-blend-mode: multiply;"></div>

  <!-- ── Grano de película ── -->
  <div class="grain-overlay absolute inset-0 pointer-events-none" style="z-index: 15;" aria-hidden="true"></div>

  <!-- ── CONTENIDO ── -->
  <div class="relative flex flex-col justify-center min-h-screen px-6 md:px-10 lg:px-16 py-32"
       style="z-index: 10;">

    <!-- Eyebrow -->
    <div class="flex items-center gap-3 mb-10 md:mb-14 opacity-0" id="hero-eyebrow">
      <div class="h-px w-10 bg-[#E8681C]" style="opacity:0.7;"></div>
      <span class="font-[family-name:var(--font-display)] text-[10px] tracking-[0.65em] uppercase"
            style="color:#E8681C; opacity:0.9; font-weight:600;">
        Colectivo · América Latina
      </span>
    </div>

    <!-- NASUA wordmark (blanco, tipografía oficial) -->
    <div class="hero-wordmark-wrap w-full overflow-visible">
      <img
        id="hero-title"
        src={asset('/logos/logo-wordmark-dark-trim.png')}
        alt="Nasúa Narica"
        class="select-none opacity-0"
        style="width: clamp(250px, 74vw, 880px); height: auto; display: block;
               will-change: transform, opacity; filter: drop-shadow(0 6px 30px rgba(0,0,0,0.55));"
        width="818" height="327"
      />
    </div>

    <!-- Subtítulo + booking -->
    <div id="hero-sub" class="mt-8 md:mt-10 opacity-0">
      <div class="w-full h-px mb-6" style="background: rgba(237,232,224,0.12);"></div>
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5">
        <p class="font-[family-name:var(--font-display)] text-[11px] tracking-[0.55em] uppercase font-500 max-w-xs"
           style="color:#E6E0D4; text-shadow: 0 1px 10px rgba(0,0,0,0.7);">
          Música Sin Fronteras &nbsp;·&nbsp; Pop Tropical &nbsp;·&nbsp; Fusión
        </p>
        <a href="#contacto"
           class="btn-orange text-xs tracking-widest py-2.5 px-6 self-start sm:self-auto">
          Booking
        </a>
      </div>
    </div>
  </div>

  <!-- ── Scroll indicator ── -->
  <div id="scroll-indicator"
       class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-0"
       style="z-index: 20;">
    <div id="scroll-line" class="w-px h-14 bg-gradient-to-b from-[#E8681C] to-transparent"></div>
  </div>
</section>

<script>
  import { animate, createTimeline, spring } from 'animejs';

  // ── Secuencia de entrada ───────────────────────────────
  const tl = createTimeline();

  tl.add('#hero-title', {
    opacity:    [0, 1],
    translateY: [70, 0],
    scale:      [0.9, 1],
    delay:      200,
    ease:       spring({ stiffness: 92, damping: 13 }),
  });

  tl.add('#hero-eyebrow', {
    opacity:    [0, 1],
    translateY: [-12, 0],
    duration:   500,
    ease:       'outQuart',
  }, 0);

  tl.add('#hero-sub', {
    opacity:    [0, 1],
    translateY: [20, 0],
    duration:   600,
    ease:       'outQuart',
  }, '-=200');

  tl.add('#scroll-indicator', {
    opacity: [0, 1],
    duration: 600,
    ease: 'outQuart',
  }, '+=500');

  animate('#scroll-line', {
    scaleY:          [1, 0.12],
    transformOrigin: 'top center',
    duration:        1200,
    loop:            true,
    alternate:       true,
    ease:            'inOutSine',
    delay:           2400,
  });

  // ── Parallax sutil (wordmark + foto) ───────────────────
  const wordmark = document.querySelector('.hero-wordmark-wrap') as HTMLElement;
  const photo    = document.querySelector('.hero-photo') as HTMLElement;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    if (wordmark) wordmark.style.transform = `translateY(${y * 0.16}px)`;
    if (photo)    photo.style.transform    = `scale(1.05) translateY(${y * 0.06}px)`;
  }, { passive: true });

  // ── Hover sutil sobre el wordmark ──────────────────────
  const title = document.getElementById('hero-title');
  title?.addEventListener('mouseenter', () => {
    animate(title, { scale: [1, 1.015, 1], duration: 700, ease: 'inOutQuad' });
  });
</script>
